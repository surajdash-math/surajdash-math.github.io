---
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FrontPageGallery from "../components/FrontPageGallery.astro";

const pageTitle = "Suraj Dash | Mathematics";
const pageDescription =
  "Suraj Dash is a PhD student in mathematics at UT Austin working in algebraic geometry, logarithmic geometry, moduli spaces, and stability conditions.";
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageURL = Astro.site
  ? new URL("/og-home.jpg", Astro.site).toString()
  : "/og-home.jpg";
---

<html lang="en" data-hero-tone="lake">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Suraj Dash" />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Evening light over Lake Austin, Texas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Evening light over Lake Austin, Texas" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/front-page-2-mobile-768w.webp"
      media="(max-width: 680px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/front-page-2-desktop-2040w.webp"
      imagesrcset="/front-page-2-desktop-768w.webp 768w, /front-page-2-desktop-1280w.webp 1280w, /front-page-2-desktop-2040w.webp 2040w, /front-page-2-desktop-3200w.webp 3200w"
      imagesizes="100vw"
      media="(min-width: 681px)"
      fetchpriority="high"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,650;0,700;1,400&amp;family=STIX+Two+Text:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap"
    />
    <ThemeInit />
    <title>{pageTitle}</title>
  </head>

  <body>
    <a class="skip-link" href="#profile">Skip to main content</a>
    <main class="page-shell">
      <header class="site-header" data-hero-tone="lake">
        <h1>Suraj Dash</h1>
        <SiteNav current="/" />
      </header>

      <FrontPageGallery />

      <div class="content-shell">
        <section class="profile" id="profile" tabindex="-1" aria-label="About Suraj Dash">
          <div class="profile-main">
            <div class="profile-copy info-card">
              <h2 class="about-heading">About me</h2>
              <div class="about-copy">
                <p class="introduction">
                  I am currently a PhD student in Mathematics at
                  <a href="https://math.utexas.edu" target="_blank" rel="noreferrer">UT Austin</a>, advised by
                  <a href="https://www.ma.utexas.edu/users/siebert/" target="_blank" rel="noreferrer">Prof. Bernd Siebert</a>.
                </p>
                <p class="introduction biographical-note">
                  Prior to joining UT Austin, I completed the
                  <a href="https://algant.eu" target="_blank" rel="noreferrer">ALGANT</a> master's program jointly at
                  Università degli Studi di Padova in Italy and Universität Duisburg-Essen
                  in Germany, writing my thesis under the supervision of
                  <a href="https://www.math.unipd.it/~tommasi/" target="_blank" rel="noreferrer">Prof. Orsola Tommasi</a>.
                  Before that, I completed my undergraduate studies at the
                  Indian Statistical Institute in Bangalore.
                </p>
              </div>
            </div>

            <div class="left-watermark">
              <section class="research-text info-card">
                <h2>Research interests</h2>
                <p>
                  My research lies in algebraic geometry, especially moduli spaces,
                  degenerations, logarithmic geometry, and stability conditions.
                </p>
                <p>
                  At present, I study logarithmic Hilbert schemes and GIT wall-crossings,
                  with applications to Chow ring computations and understanding the birational geometry of Hilbert schemes of
                  degenerating surfaces.
                </p>
                <p class="job-market-notice">
                  I am on the academic job market in Fall 2026, seeking postdoctoral positions.
                </p>
              </section>
            </div>
          </div>

          <aside class="profile-aside" aria-label="Portrait and contact information">
            <div class="portrait-frame">
              <img
                class="portrait"
                src="/suraj-dash.jpg"
                alt="Portrait of Suraj Dash"
                width="675"
                height="900"
                loading="lazy"
                decoding="async"
                onerror="this.parentElement.classList.add('is-empty'); this.remove();"
              />
              <span class="portrait-fallback" aria-hidden="true">Photo</span>
            </div>

            <section class="contact-block" aria-labelledby="contact-heading">
              <h2 class="visually-hidden" id="contact-heading">Contact information</h2>
              <address class="contact-card">
                <span><strong>Office:</strong> PMA 11.134</span>
                <span><strong>Address:</strong> University of Texas at Austin, 2515 Speedway, Austin, TX 78712</span>
                <span><strong>Email:</strong> suraj dot dash at utexas dot edu</span>
                <span><strong>CV:</strong> <a href="https://www.overleaf.com/project/63524f01ae83a61dc3606709" target="_blank" rel="noreferrer">View CV</a></span>
              </address>
            </section>
          </aside>
        </section>

        <p class="background-caption">
          Watermark: <span class="caption-math">LogHilb<sup>2</sup>(ℙ<sup>1</sup>, ∞).</span>
        </p>
        <SiteFooter />
      </div>
    </main>
  </body>
</html>

<style>
  :global(:root) {
    --bg: #f4f7f9;
    --surface: #fafcfd;
    --surface-2: #eef3f6;
    --text: #24313a;
    --heading: #344d5d;
    --muted: #53636e;
    --accent: #a7443e;
    --line: rgba(63, 86, 102, 0.18);
    --link: #286784;
    --body-glow: rgba(101, 132, 155, 0.14);
    --shadow: rgba(36, 49, 58, 0.06);
    --caption: #405661;
    --caption-shadow: rgba(252, 250, 246, 0.85);
    --card-surface: rgba(250, 252, 253, 0.8);
    --soft-card-shadow: rgba(36, 49, 58, 0.035);
  }

  :global(html[data-theme="dark"]) {
    --card-surface: rgba(31, 46, 54, 0.82);
    --soft-card-shadow: rgba(0, 0, 0, 0.14);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    position: relative;
    isolation: isolate;
    margin: 0;
    min-height: 100vh;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.58;
    color: var(--text);
    background:
      radial-gradient(circle at top right, var(--body-glow), transparent 34rem),
      var(--bg);
    transition: color 180ms ease, background-color 180ms ease;
  }

  :global(p) {
    color: var(--text);
    line-height: 1.58;
  }

  :global(a) {
    color: var(--link);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .content-shell :global(a) {
    font-weight: 600;
    text-decoration: none;
  }

  .content-shell :global(a:hover),
  .content-shell :global(a:focus-visible) {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.18em;
  }

  :global(strong) {
    font-weight: 650;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 9px 13px;
    border-radius: 6px;
    color: #fff;
    background: #173f50;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  h2,
  h3 {
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 600;
    color: var(--heading);
  }

  .page-shell {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  .content-shell {
    position: relative;
    width: min(1020px, calc(100% - 48px));
    margin: 0 auto;
    padding-bottom: 112px;
  }

  .background-caption {
    position: absolute;
    left: 0;
    bottom: 58px;
    margin: 0;
    font-size: 0.7rem;
    font-weight: 500;
    font-style: italic;
    color: var(--caption);
    opacity: 0.2;
    text-align: left;
    text-shadow: 0 1px 2px var(--caption-shadow);
  }

  :global(html[data-theme="light"]) .background-caption {
    opacity: 0.4;
  }

  :global(html[data-theme="dark"]) .background-caption {
    opacity: 0.2;
  }

  .caption-math {
    white-space: nowrap;
  }

  .caption-math sup {
    font-size: 0.72em;
    line-height: 0;
  }

  .site-header {
    --hero-header-ink: #173f50;
    --hero-header-active: #893833;
    --hero-toggle-border: rgba(23, 63, 80, 0.44);
    --hero-toggle-bg: rgba(245, 249, 250, 0.34);
    position: absolute;
    top: 32px;
    left: 50%;
    z-index: 20;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    width: min(1020px, calc(100% - 48px));
    margin-bottom: 28px;
    padding: 12px 0 18px;
    border-bottom: 0;
    transform: translateX(-50%);
  }

  :global(html[data-hero-tone="sunset"]) .site-header {
    --hero-header-ink: #fff0dd;
    --hero-header-active: #ffd09f;
    --hero-toggle-border: rgba(255, 240, 221, 0.58);
    --hero-toggle-bg: rgba(67, 22, 30, 0.3);
  }

  :global(html[data-hero-tone="sunset"] .site-header h1),
  .site-header[data-hero-tone="sunset"] h1,
  :global(html[data-hero-tone="sunset"] .site-header .site-navigation a),
  :global(html[data-hero-tone="sunset"] .site-header .theme-toggle) {
    color: #fff0dd !important;
  }

  :global(html[data-hero-tone="sunset"] .site-header .site-navigation) {
    --site-nav-active: #ffd09f;
  }

  :global(html[data-hero-tone="sunset"] .site-header .theme-toggle) {
    border-color: rgba(255, 240, 221, 0.58) !important;
    background: rgba(67, 22, 30, 0.3) !important;
  }

  :global(html[data-theme="dark"][data-hero-tone="lake"]) .site-header {
    --hero-header-ink: #edf6f8;
    --hero-header-active: #b7dce5;
    --hero-toggle-border: rgba(237, 246, 248, 0.52);
    --hero-toggle-bg: rgba(10, 27, 35, 0.3);
  }

  .site-header h1,
  :global(.site-header .site-navigation a),
  :global(.site-header .theme-toggle) {
    color: var(--hero-header-ink);
    transition: color 220ms ease, border-color 220ms ease, background-color 220ms ease,
      text-shadow 220ms ease;
  }

  .site-header h1,
  :global(.site-header .site-navigation a) {
    text-shadow: 0 1px 10px rgba(247, 251, 252, 0.36);
  }

  :global(html[data-hero-tone="sunset"] .site-header h1),
  :global(html[data-hero-tone="sunset"] .site-header .site-navigation a),
  :global(html[data-theme="dark"] .site-header h1),
  :global(html[data-theme="dark"] .site-header .site-navigation a) {
    text-shadow: 0 2px 14px rgba(22, 12, 18, 0.5);
  }

  :global(.site-header .site-navigation) {
    --site-nav-active: var(--hero-header-active);
  }

  :global(.site-header .theme-toggle) {
    border-color: var(--hero-toggle-border);
    background: var(--hero-toggle-bg);
  }

  .profile {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
    column-gap: clamp(34px, 3.5vw, 42px);
    width: 100%;
    align-items: start;
    scroll-margin-top: 24px;
  }

  .profile:focus {
    outline: none;
  }

  .profile::before {
    content: "";
    position: absolute;
    inset: -24px 0 -72px -50px;
    z-index: 0;
    pointer-events: none;
    opacity: 0.15;
    filter: grayscale(1);
    mix-blend-mode: multiply;
    background: url("/watermark.jpg") calc(50% - 150px) center / auto clamp(590px, 66vw, 700px) no-repeat;
  }

  :global(html[data-theme="light"]) .profile::before {
    background-position: -18px calc(50% - 24px);
    background-size: auto clamp(630px, 65vw, 720px);
    opacity: 0.11;
    filter: none;
  }

  .profile > * {
    position: relative;
    z-index: 1;
  }

  .profile-main {
    grid-column: 1;
    min-width: 0;
  }

  .profile-main > * {
    position: relative;
    z-index: 1;
  }

  .profile-copy {
    display: grid;
    gap: 16px;
  }

  .about-copy {
    display: grid;
    gap: 14px;
  }

  .profile-aside {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    gap: 28px;
    width: 100%;
    justify-self: start;
  }

  @media (min-width: 821px) {
  .profile-aside {
    margin-top: 13px;
  }

  :global(html[data-theme="dark"]) .profile-aside {
    margin-top: 0;
  }
}

  h1 {
    margin: 0;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: clamp(2.15rem, 3.35vw, 2.7rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--heading);
  }

  address {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 16px 17px;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.84rem;
    font-style: normal;
    line-height: 1.45;
    color: var(--text);
  }

  .contact-card,
  .info-card {
    border-radius: 18px;
    background: var(--card-surface);
    box-shadow: 0 18px 48px var(--shadow);
  }

  .contact-card {
    border: 1px solid var(--line);
    border-left: 4px solid #527789;
  }

  .info-card {
    padding: 22px 24px 24px;
    box-shadow: 0 10px 28px var(--soft-card-shadow);
  }

  :global(html[data-theme="light"]) .info-card {
    padding: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  address a {
    color: var(--link);
  }

  .contact-block {
    display: grid;
    gap: 8px;
    width: 100%;
    justify-self: start;
  }

  .portrait-frame {
    position: relative;
    width: 100%;
    justify-self: start;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-2);
  }

  .portrait {
    display: block;
    width: 100%;
    height: auto;
  }

  .portrait-fallback {
    display: none;
    position: absolute;
    inset: 0;
    place-items: center;
    color: var(--muted);
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .portrait-frame.is-empty .portrait-fallback {
    display: grid;
  }

  .portrait-frame.is-empty {
    aspect-ratio: 4 / 5;
  }

  .introduction {
    margin: 0;
    font-size: 1.1rem;
    font-style: normal;
    line-height: 1.58;
    color: var(--text);
  }

  .introduction,
  .research-text > p {
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    text-wrap: pretty;
  }

  :global(html[data-theme="dark"] body)::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url("/Watermark%20dark.jpg") center / cover no-repeat;
    opacity: 0.06;
    filter: none;
    mix-blend-mode: screen;
  }

  :global(html[data-theme="dark"]) .profile::before {
    display: none;
  }

  .profile-copy .about-heading,
  .research-text h2 {
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    font-weight: 500;
    color: var(--heading);
  }

  .about-heading {
    margin: 0;
  }

  .research-text h2 {
    margin: 0 0 16px;
  }

  .research-text > p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.58;
    color: var(--text);
  }

  .research-text {
    max-width: 680px;
    margin-top: 1.75rem;
  }

  .research-text > p + p {
    margin-top: 14px;
  }

  .research-text > .job-market-notice {
    margin-top: 18px;
    font-family: "STIX Two Text", Georgia, "Times New Roman", serif;
    font-size: 1.15rem;
    font-weight: 400;
    font-style: italic;
    line-height: 1.5;
    color: var(--accent);
    text-align: left;
    hyphens: none;
  }

  @media (max-width: 820px) {
    .introduction,
    .research-text > p {
      text-align: left;
      hyphens: none;
    }

    h1 {
      font-size: clamp(2rem, 8.6vw, 2.55rem);
    }

    .site-header {
      top: 20px;
      align-items: flex-start;
      flex-direction: column-reverse;
      gap: 16px;
      margin-bottom: 0;
    }

    .profile {
      grid-template-columns: 1fr;
      column-gap: 0;
    }

    .profile::before {
      inset: -12px -16px -48px;
      background-position: left 10%;
      background-size: min(100%, 600px) auto;
    }

    :global(html[data-theme="light"]) .profile::before {
      background-position: calc(50% - 8px) 6%;
      background-size: auto clamp(410px, 118vw, 515px);
    }

    .profile-main {
      display: contents;
    }

    .profile-copy {
      grid-column: 1;
      grid-row: 1;
    }

    .profile-aside {
      grid-column: 1;
      grid-row: 3;
      width: min(100%, 320px);
      justify-self: start;
      gap: 20px;
      margin-top: 36px;
    }

    .left-watermark {
      grid-column: 1;
      grid-row: 2;
    }

    .portrait-frame,
    .contact-block {
      justify-self: start;
    }
  }

  @media (max-width: 680px) {
    .content-shell,
    .site-header {
      width: min(100% - 32px, 1020px);
    }

    .info-card {
      padding: 20px 19px 22px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
