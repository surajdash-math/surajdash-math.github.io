---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,650;0,700;1,400&amp;family=STIX+Two+Text:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap"
    />
    <title>Suraj Dash | Mathematics</title>
  </head>

  <body>
    <main class="page-shell">
      <nav class="top-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/research">Research</a>
        <a href="/teaching">Teaching</a>
        <a href="/learning-seminars">Learning seminars</a>
        <a href="/travel">Travel</a>
      </nav>

      <section class="profile">
        <div class="profile-copy">
          <h1>Suraj Dash</h1>

          <p class="introduction">
            I am currently a PhD student in Mathematics at UT Austin, advised by Prof. Bernd Siebert.
          </p>
        </div>

        <aside class="profile-aside" aria-label="Portrait and contact information">
          <div class="portrait-frame">
            <img
              class="portrait"
              src="/suraj-dash.jpg"
              alt="Portrait of Suraj Dash"
              onerror="this.parentElement.classList.add('is-empty'); this.remove();"
            />
            <span class="portrait-fallback" aria-hidden="true">Photo</span>
          </div>

          <section class="contact-block" aria-labelledby="contact-heading">

            <address class="contact-card">
              <span><strong>Office:</strong> PMA 11.134</span>
              <span><strong>Address:</strong> University of Texas at Austin, 2515 Speedway, Austin, TX 78712</span>
              <span><strong>Email:</strong> suraj [dot] dash [at] utexas [dot] edu</span>
              <span><strong>CV:</strong> <a href="https://www.overleaf.com/project/63524f01ae83a61dc3606709" target="_blank" rel="noreferrer">View CV</a></span>
            </address>
          </section>
        </aside>

        <div class="left-watermark">
          <section class="content-section research-text">
            <h2>Research interests</h2>
            <p>
              My research lies in algebraic geometry, especially moduli spaces,
              degenerations, logarithmic geometry, and stability conditions.
            </p>
            <p>
              At present, I study logarithmic Hilbert schemes and GIT wall-crossings,
              with applications to the birational geometry of Hilbert schemes of
              degenerating K3 surfaces.
            </p>
          </section>

          <section class="content-section education">
            <h2>Short CV</h2>

            <ol>
              <li>
                <p class="date">2021–Present</p>
                <div>
                  <h3>PhD in Mathematics</h3>
                  <p>University of Texas at Austin</p>
                  <p>
                    <strong>Thesis:</strong>
                    <em>GIT wall-crossings in logarithmic Hilbert schemes and applications</em>
                  </p>
                  <p>Advisor:<a href="https://www.ma.utexas.edu/users/siebert/"> Prof. Bernd Siebert</a></p>
                </div>
              </li>

              <li>
                <p class="date">2019–2021</p>
                <div>
                  <h3>Master ALGANT</h3>
                  <p>
                    Università degli Studi di Padova, Italy · Universität Duisburg-Essen, Germany
                  </p>
                  <p>
                    <strong>Thesis:</strong>
                    <a href="http://tesi.cab.unipd.it/65771">
                      Logarithmic construction of the moduli space of admissible covers
                    </a>
                  </p>
                  <p>Advisor: <a href="https://www.math.unipd.it/~tommasi/"> Prof. Orsola Tommasi</a></p>
                </div>
              </li>

              <li>
                <p class="date">2016–2019</p>
                <div>
                  <h3>Bachelor of Science BMATH</h3>
                  <p>Indian Statistical Institute, Bangalore</p>
                </div>
              </li>
            </ol>
          </section>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(:root) {
    --bg: #f4f7f9;
    --surface: #fafcfd;
    --surface-2: #eef3f6;
    --text: #24313a;
    --heading: #344d5d;
    --muted: #53636e;
    --accent: #a7443e;
    --line: rgba(63, 86, 102, 0.18);
    --link: #426b84;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.58;
    color: var(--text);
    background:
      radial-gradient(circle at top right, rgba(101, 132, 155, 0.14), transparent 34rem),
      var(--bg);
  }

  :global(p) {
    color: var(--text);
    line-height: 1.58;
  }

  :global(a) {
    color: var(--link);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  :global(strong) {
    font-weight: 650;
  }

  h1 {
    font-family: "STIX Two Text", Georgia, "Times New Roman", serif;
    color: var(--heading);
  }

  h2,
  h3 {
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 600;
    color: var(--heading);
  }

  .page-shell {
    width: min(1100px, calc(100% - 48px));
    margin: 0 auto;
    padding: 32px 0 72px;
  }

  .top-nav {
    display: flex;
    justify-content: flex-end;
    gap: 20px;
    padding: 12px 0 44px;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.95rem;
  }

  .top-nav a {
    color: var(--link);
    text-decoration: none;
  }

  .top-nav a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .profile {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    column-gap: clamp(32px, 4vw, 48px);
    width: 100%;
    align-items: start;
  }

  .profile-copy {
    grid-column: 1;
  }

  .profile-aside {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    gap: 28px;
    width: min(100%, 360px);
    justify-self: end;
  }

  h1 {
    margin: 0 0 14px;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: clamp(2.25rem, 3.9vw, 3.6rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--heading);
  }

  address {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 16px 17px;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.84rem;
    font-style: normal;
    line-height: 1.45;
    color: var(--text);
  }

  .contact-card {
    border: 1px solid var(--line);
    border-left: 4px solid #527789;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 0 18px 48px rgba(36, 49, 58, 0.06);
  }

  address a {
    color: var(--link);
  }

  .contact-block {
    display: grid;
    gap: 8px;
    width: 92%;
    justify-self: end;
  }

  .contact-block h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 600;
    font-size: 1rem;
    color: var(--heading);
  }

  .contact-block h2::before {
    content: "";
    display: block;
    flex: 0 0 4px;
    width: 4px;
    height: 1.05em;
    border-radius: 1px;
    background: var(--accent);
  }

  .portrait-frame {
    position: relative;
    width: 92%;
    aspect-ratio: 4 / 5;
    justify-self: end;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-2);
    box-shadow: none;
  }

  .portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .portrait-fallback {
    display: none;
    position: absolute;
    inset: 0;
    place-items: center;
    border: 0;
    color: var(--muted);
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .portrait-frame.is-empty .portrait-fallback {
    display: grid;
  }

  .introduction {
    margin: 18px 0 8px;
    font-size: clamp(0.94rem, 1.1vw, 1.03rem);
    line-height: 1.58;
    color: var(--muted);
  }

  .cv-link {
    margin: 0 0 0;
    font-size: 0.98rem;
    color: var(--muted);
  }

  .cv-link a {
    color: var(--link);
    text-decoration: none;
  }

  .cv-link a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .content-section {
    grid-column: 1;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .left-watermark {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    grid-column: 1;
  }

  .left-watermark::before,
  .left-watermark::after {
    content: "";
    position: absolute;
    z-index: 0;
    pointer-events: none;
    opacity: 0.12;
    filter: grayscale(1);
    mix-blend-mode: multiply;
    transform: scale(1.2);
    transform-origin: center;
  }

  .left-watermark::before {
    inset: 0 0 55%;
    background: url("/watermark.jpg") center / contain no-repeat;
  }

  .left-watermark::after {
    inset: 45% 0 0;
    background: url("/watermark%202.jpg") center / contain no-repeat;
  }

  .left-watermark > .content-section {
    position: relative;
    z-index: 1;
  }

  .content-section h2 {
    margin: 0 0 16px;
    font-size: clamp(1.50rem, 3vw, 2.1rem);
    font-weight: 600;
    color: var(--heading);
  }

  .education h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
  }

  .content-section > p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.58;
    color: var(--text);
  }

  .research-text {
    max-width: 680px;
    margin-top: 1rem;
    padding-top: 0;
    border-top: 0;
  }

  .content-section > p + p {
    margin-top: 14px;
  }

  .education ol {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    font-weight: normal;
    list-style: none;
  }

  .education li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 22px;
  }

  .education .date,
  .education h3,
  .education li div p {
    margin: 0;
  }

  .education .date {
    padding-top: 2px;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.9rem;
    color: var(--accent);
    font-weight: normal;
  }

  .education h3 {
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--heading);
  }

  .education li div {
    display: grid;
    gap: 5px;
    line-height: 1.58;
    color: var(--text);
    font-weight: normal;
  }

  .education a {
    color: var(--link);
    font-weight: normal;
  }

  @media (max-width: 820px) {
    h1 {
      font-size: clamp(1.86rem, 8.4vw, 2.4rem);
    }

    .top-nav {
      justify-content: flex-start;
      flex-wrap: wrap;
      padding-bottom: 42px;
      font-weight: normal;
    }

    .education li {
      grid-template-columns: 1fr;
      gap: 6px;
      font-weight: normal;
    }

    .profile {
      grid-template-columns: 1fr;
      column-gap: 0;
    }

    .profile-aside {
      grid-column: 1;
      grid-row: auto;
      width: min(100%, 320px);
      justify-self: start;
      margin-top: 36px;
    }

    .portrait-frame,
    .contact-block {
      justify-self: start;
    }

    .content-section {
      grid-column: 1;
    }

  }
</style>
