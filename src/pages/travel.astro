---
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";
import PageWatermark from "../components/PageWatermark.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface TalkEntry {
  date: string;
  title: string;
  notesHref: string;
  event: string;
  eventHref: string;
}

interface ConferenceEntry {
  name: string;
  href: string;
  place: string;
  date: string;
}

const talkEntries: TalkEntry[] = [
  {
    date: "21 May 2026",
    title: "GIT Wall Crossing in the Hilbert Scheme of an Expanded Degeneration",
    notesHref: "https://drive.google.com/file/d/1A_dTPimX-5QTFeHCwzcc-hgsyosizGHf/view",
    event: "GS25",
    eventHref: "https://sites.google.com/view/gs25anniversary/startseite?authuser=0",
  },
];

const conferenceEntries: ConferenceEntry[] = [
  {
    name: "25th anniversary of the Gross-Siebert program",
    href: "https://sites.google.com/view/gs25anniversary/startseite?authuser=0",
    place: "Cetraro, Italy",
    date: "May 17–23, 2026",
  },
  {
    name: "TAGS 2026",
    href: "https://franksottile.github.io/conferences/TAGS26/index.html",
    place: "College Station, Texas",
    date: "April 17–19, 2026",
  },
  {
    name: "SRI Algebraic Geometry Bootcamp",
    href: "https://sites.google.com/view/agbootcamp2025",
    place: "Colorado State University, Fort Collins",
    date: "July 8–12, 2025",
  },
  {
    name: "WAGS",
    href: "https://sites.google.com/a/wagsymposium.org/current/arizona-fall-2024",
    place: "Tucson, Arizona",
    date: "Nov 16–17, 2024",
  },
  {
    name: "Logarithmic moduli theory: curves, sheaves, and beyond",
    href: "https://web.ma.utexas.edu/users/ikmartin/logsincamb/#logarithmic_moduli_theory_curves_sheaves_and_beyond",
    place: "Cambridge, UK",
    date: "July 29–Aug 2, 2024",
  },
  {
    name: "TAGS 2024",
    href: "https://franksottile.github.io/conferences/TAGS24/index.html",
    place: "College Station, Texas",
    date: "April 5–7, 2024",
  },
  {
    name: "Simons Math Summer Workshop",
    href: "https://scgp.stonybrook.edu/archives/39223",
    place: "SCGP, Stony Brook University, New York",
    date: "Aug 14–18, 2023",
  },
  {
    name: "Kylerec 2023",
    href: "https://kylerec.wordpress.com/kylerec-2023/",
    place: "Oakhurst, California",
    date: "June 19–23, 2023",
  },
  {
    name: "Summer School on Mirror Symmetry in the log CY setting",
    href: "https://sites.google.com/view/hms-workshop2023/homepage",
    place: "Eyam, UK",
    date: "May 26–June 1, 2023",
  },
  {
    name: "WAGS",
    href: "https://sites.google.com/a/wagsymposium.org/current/washington-spring-2023",
    place: "University of Washington, Seattle",
    date: "April 1–2, 2023",
  },
  {
    name: "Mirror symmetry for Looijenga interiors and beyond",
    href: "https://umutvg.github.io/Looijenga.html",
    place: "",
    date: "July 18–29, 2022 (online)",
  },
  {
    name: "Geometric Structures (re)United",
    href: "https://sites.google.com/view/geometry2022",
    place: "UIC, Chicago, Illinois",
    date: "June 13–17, 2022",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" as="image" href="/cetraro-watermark.jpg" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,650;0,700;1,400&amp;family=STIX+Two+Text:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap"
    />
    <ThemeInit />
    <title>Travel | Suraj Dash</title>
  </head>
  <body>
    <PageWatermark src="/cetraro-watermark.jpg" />
    <main class="page-shell">
      <SiteNav current="/travel" />

      <section class="travel-sections" aria-label="Research talks and conferences">
        <article class="publication-card">
          <header class="card-header">
            <h2>Research talks</h2>
          </header>

          <div class="talk-columns">
            <table class="talk-table" aria-label="Research talks">
              <tbody>
                {talkEntries.map((talk) => (
                  <tr>
                    <td>{talk.date}</td>
                    <td>
                      <span class="talk-title">{talk.title}</span>
                      <span class="talk-notes">
                        (<a href={talk.notesHref} target="_blank" rel="noreferrer">Notes</a>)
                      </span>
                    </td>
                    <td>
                      <a href={talk.eventHref} target="_blank" rel="noreferrer">
                        {talk.event}
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>

        <article class="publication-card">
          <header class="card-header">
            <h2>Conferences attended</h2>
          </header>

          <ul class="event-list">
            {conferenceEntries.map((conference) => (
              <li>
                <a href={conference.href} target="_blank" rel="noreferrer">{conference.name}</a><span class="event-date">{conference.place ? `, ${conference.place}` : ""} · {conference.date}</span>
              </li>
            ))}
          </ul>
        </article>
      </section>

      <p class="background-caption">Watermark: Cetraro, Italy · May 2026</p>
      <SiteFooter />
    </main>
  </body>
</html>

<style>
  :global(:root) {
    --bg: #c8d3d9;
    --surface: #fcfaf6;
    --text: #243640;
    --heading: #2d4856;
    --muted: #566a75;
    --accent: #496f7a;
    --nav-accent: #893833;
    --link: #286784;
    --line: rgba(45, 72, 86, 0.18);
    --divider: rgba(45, 72, 86, 0.14);
    --row-divider: rgba(45, 72, 86, 0.07);
    --card-edge: rgba(73, 111, 122, 0.42);
    --background-overlay-start: rgba(200, 211, 217, 0.47);
    --background-overlay-end: rgba(200, 211, 217, 0.47);
    --card-bg-soft: rgba(252, 250, 246, 0.90);
    --shadow: rgba(36, 54, 64, 0.06);
    --caption: #405661;
    --caption-shadow: rgba(252, 250, 246, 0.85);
  }

  :global(html[data-theme="dark"] .page-watermark) {
    filter: brightness(1.08);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
    transition: color 180ms ease, background-color 180ms ease;
  }

  :global(a) {
    color: var(--link);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .travel-sections :global(a) {
    font-weight: 600;
    text-decoration: none;
  }

  .travel-sections :global(a:hover),
  .travel-sections :global(a:focus-visible) {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.18em;
  }

  h2 {
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 600;
    color: var(--heading);
  }

  .page-shell {
    position: relative;
    z-index: 1;
    width: min(1100px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 32px 0 112px;
  }

  .travel-sections {
    display: grid;
    gap: 14px;
    width: min(100%, 1000px);
    margin: 0 auto;
  }

  .publication-card {
    position: relative;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card-bg-soft);
    box-shadow: 0 10px 28px var(--shadow);
  }

  .publication-card::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: var(--card-edge);
    box-shadow: 1px 0 8px var(--card-edge);
    pointer-events: none;
  }

  .publication-card h2 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--heading);
  }

  :global(html[data-theme="light"]) .publication-card h2 {
    font-weight: 700;
  }

  .card-header {
    padding-bottom: 13px;
    margin-bottom: 2px;
    border-bottom: 1px solid var(--divider);
  }

  .talk-columns {
    overflow-x: auto;
  }

  .talk-table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .talk-table tr + tr {
    border-top: 1px solid var(--row-divider);
  }

  .talk-table td {
    padding: 12px 0 10px;
    line-height: 1.5;
    text-align: left;
    vertical-align: top;
  }

  .talk-table td:first-child {
    width: 16%;
    color: var(--date-accent, var(--accent));
    font-size: 1em;
    white-space: nowrap;
  }

  .talk-table td:nth-child(2) {
    width: 64%;
    padding-left: clamp(42px, 5vw, 64px);
  }

  .talk-table td:last-child {
    width: 20%;
    padding-left: clamp(56px, 6vw, 76px);
    white-space: nowrap;
  }

  .talk-title {
    color: var(--muted);
    font-style: italic;
  }

  .talk-notes {
    margin-left: 0.25rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .event-list {
    margin: 0;
    padding: 10px 0 0 1.25rem;
  }

  .event-list li {
    padding: 4px 0;
    color: var(--text);
    line-height: 1.55;
  }

  .event-list li::marker {
    color: var(--conference-bullet, var(--accent));
  }

  .event-date {
    color: var(--muted);
  }

  .background-caption {
    position: absolute;
    right: 0;
    bottom: 58px;
    margin: 0;
    font-size: 0.7rem;
    font-weight: 500;
    font-style: italic;
    color: var(--caption);
    text-align: right;
    text-shadow: 0 1px 2px var(--caption-shadow);
  }

  @media (max-width: 680px) {
    .page-shell {
      width: min(100% - 32px, 1100px);
    }

    .publication-card {
      min-width: 0;
      padding: 18px;
    }

    .talk-columns {
      overflow: visible;
    }

    .talk-table {
      min-width: 0;
      table-layout: auto;
    }

    .talk-table tbody {
      display: grid;
    }

    .talk-table tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 5px;
      padding: 12px 0 10px;
    }

    .talk-table td {
      width: auto !important;
      padding: 0 !important;
      white-space: normal !important;
    }
  }
</style>
