---
import { getImage } from "astro:assets";
import miscWatermark from "../assets/misc-watermark.jpg";
import PageWatermark from "../components/PageWatermark.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteVersion from "../components/SiteVersion.astro";
import ThemeInit from "../components/ThemeInit.astro";

const wallpaper = await getImage({
  src: miscWatermark,
  width: Math.min(1600, miscWatermark.width),
  format: "webp",
  quality: 85,
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Miscellaneous — Suraj Dash." />
    <SiteVersion />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,650;0,700;1,400&amp;family=STIX+Two+Text:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap" />
    <link rel="preload" as="image" href={wallpaper.src} />
    <ThemeInit />
    <title>Miscellaneous | Suraj Dash</title>
  </head>
  <body class="misc-page">
    <PageWatermark src={wallpaper.src} />
    <main class="page-shell">
      <div class="misc-content">
        <article class="misc-card" aria-labelledby="misc-title">
          <h1 id="misc-title">Miscellaneous</h1>
          <ul class="misc-links">
            <li>
              <a href="https://surajdash-math.github.io/bibliotheca/" target="_blank" rel="noopener noreferrer">A collection of my favorite literature</a>
            </li>
            <li>
              <a href="https://khaihoanmath.github.io/polynomial-arithmetic-atlas/" target="_blank" rel="noopener noreferrer">Nguyen Dang Khai Hoan's webpage</a>
              <span class="entry-description">on polynomials and their Galois groups</span>
            </li>
            <li>
              <a href="https://web.ma.utexas.edu/users/ikmartin/projects/" target="_blank" rel="noopener noreferrer">Some interesting projects by Isaac Martin</a>
            </li>
          </ul>
        </article>
      </div>
      <p class="background-caption">Watermark: UT Austin garden</p>
      <SiteFooter />
    </main>
  </body>
</html>



<style>
  :global(:root) {
    color-scheme: light;
    --bg: #d9e5df;
    --text: #293c47;
    --heading: #284959;
    --link: #28657e;
    --line: rgba(41, 73, 88, .46);
    --card-edge: #547684;
    --caption: #2d4652;
    --caption-shadow: rgba(252, 250, 246, .96);
    --shadow: rgba(34, 62, 51, .12);
    --card-bg: rgba(248, 251, 252, .95);
    --background-overlay-start: rgba(224, 235, 228, .46);
    --background-overlay-end: rgba(224, 235, 228, .58);
  }
  :global(html[data-theme="dark"]) {
    color-scheme: dark;
    --bg: #111d1b;
    --text: #d7e0e4;
    --heading: #edf2f4;
    --link: #8abfd2;
    --line: rgba(195, 215, 224, .20);
    --card-edge: rgba(143, 196, 220, .36);
    --caption: #b7c5ca;
    --caption-shadow: rgba(0, 0, 0, .8);
    --shadow: rgba(0, 0, 0, .22);
    --card-bg: rgba(31, 46, 54, .92);
    --background-overlay-start: rgba(10, 20, 18, .68);
    --background-overlay-end: rgba(10, 20, 18, .78);
  }
  :global(*) { box-sizing: border-box; }
  :global(body) {
    position: relative;
    isolation: isolate;
    margin: 0;
    min-height: 100vh;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 19.8px;
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
  }
  :global(a) { color: var(--link); }
  :global(body.misc-page .page-watermark) {
    background-position: center;
    background-size: auto, cover, auto;
    background-repeat: no-repeat;
  }
  .page-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(1100px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding-top: 64px;
  }
  .misc-content { flex: none; }
  .misc-card {
    position: relative;
    width: min(100%, 980px);
    min-height: 360px;
    margin: 0 auto;
    padding: 32px clamp(24px, 4vw, 48px) 38px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card-bg);
    box-shadow: 6px 6px 0 rgba(31, 57, 69, .15);
  }
  .misc-links {
    margin: 28px 0 0;
    padding-left: 24px;
    list-style: disc;
  }
  .misc-links li { padding: 12px 4px 14px 10px; }
  .misc-links li + li { border-top: 1px solid color-mix(in srgb, var(--line) 55%, transparent); }
  .misc-links li::marker { color: var(--link); font-size: 1.05em; }
  .misc-links a {
    font-family: "STIX Two Text", Georgia, serif;
    font-size: clamp(18px, 1.6vw, 21px);
    font-weight: 500;
    line-height: 1.3;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }
  .misc-links a:hover { text-decoration-color: currentColor; }
  .misc-links a:focus-visible { outline: 2px solid var(--link); outline-offset: 6px; border-radius: 2px; }
  .entry-description { display: block; margin-top: 10px; font-size: .95rem; line-height: 1.55; color: color-mix(in srgb, var(--text) 82%, transparent); }
  .misc-card::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: var(--card-edge);
    pointer-events: none;
  }
  :global(html[data-theme="dark"]) .misc-card {
    border-radius: 20px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, .24);
  }
  :global(html[data-theme="dark"]) .misc-card::before {
    box-shadow: 1px 0 8px var(--card-edge);
  }
  .background-caption {
    margin: auto 0 0;
    padding-top: 32px;
    font-size: .77rem;
    font-weight: 500;
    font-style: italic;
    color: var(--caption);
    text-align: right;
    text-shadow: 0 1px 2px var(--caption-shadow);
  }
  :global(html[data-theme="dark"]) .background-caption {
    font-weight: 400;
    opacity: .45;
  }
  h1 {
    margin: 0;
    color: var(--heading);
    font-family: "STIX Two Text", Georgia, serif;
    font-size: clamp(32px, 3.4vw, 42px);
    font-weight: 500;
    line-height: 1.2;
  }
  @media (max-width: 680px) {
    .page-shell { width: calc(100% - 32px); padding-top: 32px; }
    .misc-card { min-height: 0; padding: 24px 20px 28px; }
    .misc-links { margin-top: 20px; padding-left: 20px; }
    .misc-links li { padding-left: 5px; padding-block: 10px; }
  }
</style>
