---
import { getImage } from "astro:assets";
import franciaFlip from "../assets/misc-francia-flip.png";
import MiscLayout from "../layouts/MiscLayout.astro";
import MiscCollectionIcon from "../components/MiscCollectionIcon.astro";
import { miscCollections } from "../data/misc-collections";
import { siteBuildVersion } from "../lib/site-build-version";

const cardIllustration = await getImage({ src: franciaFlip, width: 960, format: "webp", quality: 85 });
---

<MiscLayout title="Miscellaneous" overview>
  <div class="collection-grid">
    {miscCollections.map((collection) => (
      <a
        class:list={["collection-card", { "collection-card--illustrated": collection.slug === "mathematical-databases" }]}
        href={`/misc/${collection.slug}/?v=${siteBuildVersion}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-labelledby={`${collection.slug}-title`}
        aria-describedby="collection-new-tab"
      >
        {collection.slug === "mathematical-databases" && <img class="collection-art" src={cardIllustration.src} width={cardIllustration.attributes.width} height={cardIllustration.attributes.height} alt="" aria-hidden="true" decoding="async" />}
        <span class="collection-icon"><MiscCollectionIcon name={collection.icon} /></span>
        <h2 id={`${collection.slug}-title`}>{collection.title}</h2>
      </a>
    ))}
  </div>
  <p id="collection-new-tab" class="visually-hidden">Opens in a new tab.</p>
</MiscLayout>

<style>
  .collection-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .collection-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 254px;
    padding: 28px 32px 22px;
    color: var(--heading);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  .collection-card::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: var(--card-edge);
    pointer-events: none;
  }
  :global(html[data-theme="dark"]) .collection-card::before { box-shadow: 1px 0 8px var(--card-edge); }
  .collection-icon { display: block; margin-bottom: 18px; color: var(--link); }
  h2 {
    max-width: 25ch;
    margin: 0 0 22px;
    color: var(--heading);
    font-family: "STIX Two Text", Georgia, serif;
    font-size: clamp(25px, 2.2vw, 29px);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .collection-card--illustrated { isolation: isolate; }
  .collection-art {
    position: absolute;
    inset: 10px 12px;
    width: calc(100% - 24px);
    height: calc(100% - 20px);
    object-fit: contain;
    object-position: right center;
    opacity: .22;
    mix-blend-mode: multiply;
    mask-image: linear-gradient(90deg, transparent 8%, #000 85%);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .collection-card--illustrated .collection-icon,
  .collection-card--illustrated h2 { position: relative; z-index: 1; }
  :global(html[data-theme="dark"]) .collection-art {
    opacity: .18;
    filter: invert(1) hue-rotate(180deg);
    mix-blend-mode: screen;
  }
  .collection-card:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 5px; }
  @media (hover: hover) {
    .collection-card:hover { transform: translateY(-4px); border-color: var(--link); box-shadow: 8px 10px 0 rgba(31, 57, 69, .17); }
    .collection-card:hover h2 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
    :global(html[data-theme="dark"]) .collection-card:hover { box-shadow: 0 18px 38px rgba(0, 0, 0, .32); }
  }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 740px) {
    .collection-grid { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .collection-card { min-height: 216px; padding: 24px 26px 20px; }
    .collection-icon { margin-bottom: 16px; }
    h2 { font-size: 27px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .collection-card { transition: none; }
    .collection-card:hover { transform: none; }
  }
</style>
