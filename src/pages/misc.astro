---
import { getImage } from "astro:assets";
import miscWatermark from "../assets/misc-watermark.jpg";
import PageWatermark from "../components/PageWatermark.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteVersion from "../components/SiteVersion.astro";
import ThemeInit from "../components/ThemeInit.astro";

const wallpaper = await getImage({
  src: miscWatermark,
  width: Math.min(1600, miscWatermark.width),
  format: "webp",
  quality: 85,
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Miscellaneous — Suraj Dash." />
    <SiteVersion />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,650;0,700;1,400&amp;family=STIX+Two+Text:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap" />
    <link rel="preload" as="image" href={wallpaper.src} />
    <ThemeInit />
    <title>Miscellaneous | Suraj Dash</title>
  </head>
  <body>
    <PageWatermark src={wallpaper.src} />
    <main class="page-shell">
      <div class="misc-content">
        <article class="misc-card" aria-labelledby="misc-title">
          <h1 id="misc-title">Miscellaneous</h1>
        </article>
      </div>
      <p class="background-caption">Watermark: A childhood painting</p>
      <SiteFooter />
    </main>
  </body>
</html>

<script>
  let cleanupCardReference = () => {};

  async function matchCopyrightCard() {
    cleanupCardReference();
    const card = document.querySelector<HTMLElement>(".misc-card");
    if (!card) return;

    const controller = new AbortController();
    const { signal } = controller;
    let frame: HTMLIFrameElement | undefined;
    let observer: ResizeObserver | undefined;
    cleanupCardReference = () => {
      controller.abort();
      observer?.disconnect();
      frame?.remove();
    };

    try {
      const version = document.querySelector('meta[name="site-build-version"]')?.getAttribute("content");
      const response = await fetch(`/copyright/?v=${encodeURIComponent(version ?? "")}`, { signal });
      if (!response.ok) return;
      const reference = new DOMParser().parseFromString(await response.text(), "text/html");
      const notice = reference.querySelector(".notice-card");
      const shell = reference.querySelector(".page-shell");
      if (!notice || !shell || signal.aborted) return;

      // Measure the current Copyright card without running its scripts or
      // loading its navigation, wallpaper, or footer. The reference is hidden
      // from both visitors and assistive technology.
      reference.querySelectorAll('script, link[rel="preload"], link[rel="modulepreload"]').forEach(el => el.remove());
      const referenceShell = shell.cloneNode(false) as HTMLElement;
      referenceShell.append(notice);
      reference.body.replaceChildren(referenceShell);
      reference.documentElement.dataset.theme = document.documentElement.dataset.theme;
      const base = reference.createElement("base");
      base.href = new URL("/copyright/", window.location.href).href;
      reference.head.prepend(base);

      frame = document.createElement("iframe");
      frame.title = "Card sizing reference";
      frame.setAttribute("aria-hidden", "true");
      frame.inert = true;
      frame.tabIndex = -1;
      frame.sandbox.add("allow-same-origin");
      frame.style.cssText = "position:fixed;left:0;top:0;transform:translateX(-200%);visibility:hidden;pointer-events:none;border:0;";
      const resizeReference = () => {
        if (!frame) return;
        frame.style.width = `${window.innerWidth}px`;
        frame.style.height = `${window.innerHeight}px`;
      };
      resizeReference();
      window.addEventListener("resize", resizeReference, { signal });
      frame.addEventListener("load", async () => {
        const doc = frame?.contentDocument;
        const referenceCard = doc?.querySelector<HTMLElement>(".notice-card");
        if (!doc || !referenceCard || signal.aborted) return;
        await doc.fonts.ready;
        if (signal.aborted) return;
        const syncHeight = () => {
          const height = referenceCard.getBoundingClientRect().height;
          if (height > 0 && card.isConnected) {
            card.style.setProperty("--copyright-card-height", `${height}px`);
            card.dataset.dimensionsMatched = "true";
          }
        };
        observer = new ResizeObserver(syncHeight);
        observer.observe(referenceCard);
        syncHeight();
      }, { once: true, signal });
      frame.srcdoc = `<!doctype html>${reference.documentElement.outerHTML}`;
      document.body.append(frame);
    } catch {
      // Keep the normal card layout if the reference page cannot be retrieved.
    }
  }

  matchCopyrightCard();
  document.addEventListener("astro:page-load", matchCopyrightCard);
  document.addEventListener("astro:before-swap", () => cleanupCardReference());
</script>

<style>
  :global(:root) {
    color-scheme: light;
    --bg: #d9e5df;
    --text: #293c47;
    --heading: #284959;
    --link: #28657e;
    --line: rgba(41, 73, 88, .46);
    --card-edge: #547684;
    --caption: #2d4652;
    --caption-shadow: rgba(252, 250, 246, .96);
    --shadow: rgba(34, 62, 51, .12);
    --card-bg: rgba(248, 251, 252, .95);
    --background-overlay-start: rgba(224, 235, 228, .46);
    --background-overlay-end: rgba(224, 235, 228, .58);
  }
  :global(html[data-theme="dark"]) {
    color-scheme: dark;
    --bg: #111d1b;
    --text: #d7e0e4;
    --heading: #edf2f4;
    --link: #8abfd2;
    --line: rgba(195, 215, 224, .20);
    --card-edge: rgba(143, 196, 220, .36);
    --caption: #b7c5ca;
    --caption-shadow: rgba(0, 0, 0, .8);
    --shadow: rgba(0, 0, 0, .22);
    --card-bg: rgba(31, 46, 54, .92);
    --background-overlay-start: rgba(10, 20, 18, .68);
    --background-overlay-end: rgba(10, 20, 18, .78);
  }
  :global(*) { box-sizing: border-box; }
  :global(body) {
    position: relative;
    isolation: isolate;
    margin: 0;
    min-height: 100vh;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 19.8px;
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
  }
  :global(a) { color: var(--link); }
  :global(.page-watermark) { background-position: center 62%; }
  .page-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(1100px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding-top: 64px;
  }
  .misc-content { flex: none; }
  .misc-card {
    position: relative;
    width: min(100%, 980px);
    min-height: var(--copyright-card-height, 100svh);
    margin: 0 auto;
    padding: 32px clamp(24px, 4vw, 48px) 38px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card-bg);
    box-shadow: 6px 6px 0 rgba(31, 57, 69, .15);
  }
  .misc-card::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: var(--card-edge);
    pointer-events: none;
  }
  :global(html[data-theme="dark"]) .misc-card {
    border-radius: 20px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, .24);
  }
  :global(html[data-theme="dark"]) .misc-card::before {
    box-shadow: 1px 0 8px var(--card-edge);
  }
  .background-caption {
    margin: auto 0 0;
    padding-top: 32px;
    font-size: .77rem;
    font-weight: 500;
    font-style: italic;
    color: var(--caption);
    text-align: right;
    text-shadow: 0 1px 2px var(--caption-shadow);
  }
  :global(html[data-theme="dark"]) .background-caption {
    font-weight: 400;
    opacity: .45;
  }
  h1 {
    margin: 0;
    color: var(--heading);
    font-family: "STIX Two Text", Georgia, serif;
    font-size: clamp(32px, 3.4vw, 42px);
    font-weight: 500;
    line-height: 1.2;
  }
  @media (max-width: 680px) {
    .page-shell { width: calc(100% - 32px); padding-top: 32px; }
    .misc-card { padding: 24px 20px 28px; }
  }
</style>
