    seminar: "Moduli in Algebraic and Symplectic geometry",
    place: "UT Austin",
    notesHref: "https://drive.google.com/file/d/1VxpPCmAxMw0Mhz713AYsUZs-Dhr58TSG/view?usp=sharing",
