    datetime: "2026-09-18",
    title: "Hodge theory on Kähler manifolds",
    seminar: "Geometry literature seminar",
    place: "UT Austin",
  },
  {
    date: "05/12/2024",
    datetime: "2024-12-05",
    title: "Donaldson–Thomas invariants via microlocal geometry",
    seminar: "Moduli in Algebraic and Symplectic geometry",
    place: "UT Austin",
  },
  {
