---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" as="image" href={watermarkSrc} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,650;0,700;1,400&amp;family=STIX+Two+Text:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap"
    />
    <ThemeInit />
    <title>Seminars | Suraj Dash</title>
  </head>
  <body class="seminars-page">
    <PageWatermark src={watermarkSrc} />
    <main class="page-shell">
      <SiteNav current="/learning-seminars" />

      <section class="seminar-sections" aria-label="Learning seminars and expository talks">
        <article class="publication-card">
          <header class="card-header">
            <h2>Learning seminars</h2>
          </header>

          <div class="seminar-columns">
            <table class="seminar-table" aria-label="Learning seminar entries">
              <tbody>
                {seminarEntries.map((seminar) => (
                  <tr>
                    <td class="seminar-name">
                      {seminar.titleHref ? (
                        <a href={seminar.titleHref} target="_blank" rel="noreferrer">
                          {seminar.title}
                        </a>
                      ) : (
                        seminar.title
                      )}
                      {seminar.note && <span> ({seminar.note})</span>}
                    </td>
                    <td class="seminar-plan">
                      <a href={seminar.planHref} target="_blank" rel="noreferrer">
                        {seminar.planLabel}
                      </a>
                    </td>
                    <td class="term">{seminar.term}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>

        <article class="publication-card">
          <header class="card-header">
            <h2>Expository talks</h2>
          </header>

          <div class="seminar-columns">
            <table class="seminar-table expository-table" aria-label="Expository talk entries">
              <tbody>
                {expositoryTalkEntries.map((talk) => (
                  <tr>
                    <td class="seminar-name">
                      {talk.title}
                      <span class="talk-event">{talk.seminar} · {talk.place}</span>
                    </td>
                    <td class="term talk-date">
                      <time datetime={talk.datetime}>{talk.date}</time>
                      {talk.datetime > today && <span class="talk-status">Upcoming</span>}
                    </td>
                    <td class="seminar-plan talk-notes">
                      {talk.notesHref && (
                        <a href={talk.notesHref} target="_blank" rel="noreferrer">
                          Notes
                        </a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      </section>

      <p class="background-caption">Watermark: Discussions with Yixian Wu</p>
      <SiteFooter />
    </main>
  </body>
</html>

<style>
  :global(:root) {
    --bg: #c8d3d9;
    --surface: #fcfaf6;
    --text: #243640;
    --heading: #2d4856;
    --muted: #566a75;
    --accent: #496f7a;
    --nav-accent: #893833;
    --link: #286784;
    --line: rgba(45, 72, 86, 0.18);
    --divider: rgba(45, 72, 86, 0.14);
    --row-divider: rgba(45, 72, 86, 0.07);
    --card-edge: rgba(73, 111, 122, 0.42);
    --background-overlay-start: rgba(200, 211, 217, 0.10);
    --background-overlay-end: rgba(200, 211, 217, 0.60);
    --seminar-card-bg: rgba(252, 250, 246, 0.90);
    --shadow: rgba(36, 54, 64, 0.06);
    --caption: #405661;
    --caption-shadow: rgba(252, 250, 246, 0.85);
  }

  :global(html[data-theme="dark"]) {
    --seminar-card-bg: rgba(31, 46, 54, 0.93);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
    transition: color 180ms ease, background-color 180ms ease;
  }

  :global(a) {
    color: var(--link);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .seminar-sections :global(a) {
    font-weight: 600;
    text-decoration: none;
  }

  .seminar-sections :global(a:hover),
  .seminar-sections :global(a:focus-visible) {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.18em;
  }

  h2 {
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 600;
    color: var(--heading);
  }

  .page-shell {
    position: relative;
    z-index: 1;
    width: min(1100px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 32px 0 112px;
  }

  .seminar-sections {
    width: min(100%, 920px);
    margin: 0 auto;
  }

  .publication-card {
    position: relative;
    padding: 24px 26px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--seminar-card-bg);
    box-shadow: 0 10px 28px var(--shadow);
  }

  .publication-card + .publication-card {
    margin-top: 28px;
  }

  .publication-card::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: var(--card-edge);
    box-shadow: 1px 0 8px var(--card-edge);
    pointer-events: none;
  }

  .publication-card h2 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--heading);
  }

  .card-header {
    padding-bottom: 13px;
    margin-bottom: 2px;
    border-bottom: 1px solid var(--divider);
  }

  .seminar-columns {
    overflow-x: auto;
  }

  .seminar-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .seminar-table tr + tr {
    border-top: 1px solid var(--row-divider);
  }

  .seminar-table td {
    padding: 12px 0 10px;
    line-height: 1.5;
    text-align: left;
    vertical-align: top;
  }

  .seminar-name {
    width: 58%;
  }

  .seminar-name span {
    color: var(--muted);
    font-weight: 400;
  }

  .seminar-plan {
    width: 22%;
    padding-left: clamp(28px, 3.5vw, 40px) !important;
    white-space: nowrap;
  }

  .term {
    width: 20%;
    padding-left: clamp(32px, 4vw, 44px) !important;
    color: var(--date-accent, var(--accent));
    white-space: normal;
  }

  .talk-event {
    display: block;
  }

  .talk-date {
    width: 22%;
  }

  .talk-notes {
    width: 20%;
  }

  .talk-status {
    display: block;
    font-size: 0.75rem;
  }

  .background-caption {
    position: absolute;
    right: 0;
    bottom: 58px;
    margin: 0;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: normal;
    color: var(--caption);
    text-align: right;
    text-shadow: 0 1px 2px var(--caption-shadow);
  }

  @media (max-width: 680px) {
    .page-shell {
      width: min(100% - 32px, 1100px);
    }

    .publication-card {
      padding: 20px;
    }
  }

  /* Light mode: a cool slate seminar ledger. */
  :global(html[data-theme="light"]) {
    --bg: #d8e4e9;
    --surface: #f7fafb;
    --text: #243640;
    --heading: #294957;
    --muted: #586b75;
    --accent: #4b7280;
    --nav-accent: #4b7280;
    --date-accent: #3f7081;
    --link: #286784;
    --line: rgba(41, 73, 88, 0.46);
    --divider: rgba(41, 73, 88, 0.27);
    --row-divider: rgba(41, 73, 88, 0.19);
    --card-edge: #547684;
    --background-overlay-start: rgba(205, 220, 226, 0.42);
    --background-overlay-end: rgba(215, 228, 233, 0.56);
    --seminar-card-bg: rgba(248, 251, 252, 0.95);
    --shadow: rgba(31, 57, 69, 0.15);
    --caption: #294957;
    --caption-shadow: rgba(247, 250, 251, 0.96);
  }

  :global(html[data-theme="light"] body.seminars-page .page-watermark)::after {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 176px;
    background: linear-gradient(
      to bottom,
      rgba(225, 235, 239, 0.46),
      rgba(225, 235, 239, 0.22) 58%,
      rgba(225, 235, 239, 0)
    );
  }

  :global(html[data-theme="light"]) .publication-card {
    min-width: 0;
    border-radius: 14px;
    box-shadow: 6px 6px 0 rgba(31, 57, 69, 0.15);
  }

  :global(html[data-theme="light"]) .publication-card::before {
    box-shadow: none;
  }

  :global(html[data-theme="light"]) .publication-card h2 {
    font-family: "STIX Two Text", Georgia, "Times New Roman", serif;
    font-size: 1.34rem;
    font-weight: 700;
    letter-spacing: -0.012em;
  }

  :global(html[data-theme="light"]) .card-header {
    padding-bottom: 15px;
    border-bottom-color: rgba(41, 73, 88, 0.42);
  }

  :global(html[data-theme="light"]) .seminar-table td {
    padding-top: 14px;
    padding-bottom: 13px;
  }

  :global(html[data-theme="light"]) .term {
    font-size: 0.84rem;
    font-weight: 400;
    letter-spacing: 0.025em;
  }

  :global(html[data-theme="light"]) .background-caption {
    opacity: 0.78;
  }

  @media (max-width: 680px) {
    .seminar-columns {
      overflow: visible;
    }

    .seminar-table {
      min-width: 0;
      table-layout: auto;
    }

    .seminar-table tbody {
      display: grid;
    }

    .seminar-table tr {
      display: grid;
      grid-template-columns: minmax(min-content, 1fr) auto;
      gap: 5px 16px;
      padding: 14px 0;
    }

    .seminar-table td {
      width: auto !important;
      padding: 0 !important;
      white-space: normal !important;
    }

    .seminar-name {
      grid-column: 1 / -1;
    }

    .seminar-plan {
      grid-column: 1;
    }

    .term {
      grid-column: 2;
    }

    .talk-date {
      grid-column: 1;
    }

    .talk-notes {
      grid-column: 2;
    }
  }
</style>
