---
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";
import PageWatermark from "../components/PageWatermark.astro";
import SiteFooter from "../components/SiteFooter.astro";

const watermarkSrc = "/Board work.jpg";

interface TaCourse {
  term: string;
  code?: string;
  title: string;
}

interface DrpEntry {
  term: string;
  mentee: string;
  topic: string;
  program?: string;
}

const taCourses: TaCourse[] = [
  {
    term: "Fall 2026",
    code: "M 408K",
    title: "Differential Calculus",
  },
  {
    term: "Fall 2025",
    code: "M 341",
    title: "Linear Algebra",
  },
  {
    term: "Spring 2025",
    code: "M 362L",
    title: "Algebraic Topology",
  },
  {
    term: "Fall 2024",
    code: "M 362K",
    title: "Probability Theory",
  },
  {
    term: "Summer 2024",
    code: "M 325K",
    title: "Discrete Mathematics",
  },
  {
    term: "Spring 2024",
    code: "M 340L",
    title: "Matrix Calculations and Linear Algebra",
  },
  {
    term: "Fall 2023",
    code: "M 340L",
    title: "Matrix Calculations and Linear Algebra",
  },
  {
    term: "Spring 2022",
    code: "M 408D",
    title: "Multivariable Calculus",
  },
  {
    term: "Fall 2021",
    code: "M 427L",
    title: "Advanced Calculus for Applications II",
  },
];

const drpEntries: DrpEntry[] = [
{
    term: "Fall 2026",
    mentee: "Mai Huynh",
    topic: "The Apéry–Beukers proof of the irrationality of ζ(3)",
  },
  {
    term: "Spring 2026",
    mentee: "Dekan Chan",
    topic: "Divisors on Graphs and the Baker-Norine Riemann-Roch theorem",
  },
  {
    term: "Fall 2025",
    mentee: "Gerardo Vega",
    topic: "Enumerative Algebraic Geometry of Conics",
  },
  {
    term: "Spring 2025",
    mentee: "Yang Shao",
    topic: "Graph theory and applications",
  },
  {
    term: "Fall 2024",
    mentee: "Yash Totlani",
    topic: "Geometry and combinatorics of the Hilbert scheme of points on nodal curves",
  },
  {
    term: "Fall 2024",
    mentee: "Malaika Shah",
    topic: "Graph theory and applications in Probability theory",
  },
  {
    term: "Spring 2024",
    mentee: "Trevor Jess",
    topic: "Mahler's theorem, Monsky's theorem and recurrence sequences using p-adic analysis",
  },
  {
    term: "Fall 2023",
    mentee: "Harshavardhan Iyer",
    topic: "Monsky's theorem and p-adic numbers",
  },
  {
    term: "Spring 2023",
    mentee: "Catherine Watson",
    topic: "Lagrange’s four-square theorem: classical and modern proofs",
  },
  {
    term: "Spring 2023",
    mentee: "Vincent Tran",
    topic: "An introduction to algebraic number theory",
  },
  {
    term: "Fall 2022",
    mentee: "Utkarsh Nigam",
    topic: "A gentle introduction to moduli spaces via illustrations",
  },
  {
    term: "Fall 2022",
    mentee: "Krishnendu Kar",
    topic: "A gentle introduction to topological stacks",
    program: "Twoples DRP",
  },
  {
    term: "Spring 2022",
    mentee: "Michael Panner",
    topic: "Moduli Spaces and Geometric Invariant Theory",
  },
  {
    term: "Fall 2021",
    mentee: "Min Ho Lee",
    topic: "Algebro-Geometric methods in Sudoku puzzles",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" as="image" href={watermarkSrc} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,650;0,700;1,400&amp;family=STIX+Two+Text:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap"
    />
    <ThemeInit />
    <title>Learning and teaching | Suraj Dash</title>
  </head>
  <body class="teaching-page">
    <PageWatermark src={watermarkSrc} />
    <main class="page-shell">
      <SiteNav current="/teaching" />

      <section class="teaching-sections" aria-label="Learning and teaching">
        <article class="publication-card">
          <header class="card-header">
            <h2>Teaching Assistant (UT Austin)</h2>
          </header>
          <div class="ta-columns">
            <table class="ta-table" aria-label="Teaching assistant duties by semester and course">
              <tbody>
                {taCourses.map((course) => (
                  <tr>
                    <td class="term">{course.term}</td>
                    <td class="mentee">{course.code ?? "—"}</td>
                    <td class="topic">{course.title}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>

        <article class="publication-card">
          <header class="card-header drp-header">
            <h2>Directed Reading Program </h2>
            <p class="drp-info">
              Learn more about the
              <a href="https://sites.google.com/view/utmathdrp/about">DRP at UT Austin</a>.
            </p>
          </header>
          <ul class="record-list">
            {drpEntries.map((entry) => (
              <li>
                <span class="term">{entry.term}</span>
                <div class="entry-details">
                  <span class="mentee">{entry.mentee}</span>
                  <span class="topic">{entry.topic}</span>
                  {entry.program && <span class="program">{entry.program}</span>}
                </div>
              </li>
            ))}
          </ul>
        </article>

        
      </section>
       <p class="background-caption">Watermark: Discussions with Yixian Wu</p>
      <SiteFooter />
    </main>
  </body>
</html>

<style>
  :global(:root) {
    --bg: #c8d3d9;
    --surface: #fcfaf6;
    --text: #243640;
    --heading: #2d4856;
    --muted: #566a75;
    --accent: #496f7a;
    --nav-accent: #893833;
    --link: #286784;
    --line: rgba(45, 72, 86, 0.18);
    --divider: rgba(45, 72, 86, 0.14);
    --ta-divider: rgba(45, 72, 86, 0.07);
    --card-edge: rgba(73, 111, 122, 0.42);
    --background-overlay-start: rgba(200, 211, 217, 0.28);
    --background-overlay-end: rgba(200, 211, 217, 0.48);
    --card-bg: rgba(252, 250, 246, 0.9);
    --shadow: rgba(36, 54, 64, 0.06);
    --caption: #405661;
    --caption-shadow: rgba(252, 250, 246, 0.85);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
    transition: color 180ms ease, background-color 180ms ease;
  }

  :global(p) {
    color: var(--text);
    line-height: 1.6;
  }

  :global(a) {
    color: var(--link);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .teaching-sections :global(a) {
    font-weight: 600;
    text-decoration: none;
  }

  .teaching-sections :global(a:hover),
  .teaching-sections :global(a:focus-visible) {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.18em;
  }

  h2 {
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 600;
    color: var(--heading);
  }

  .page-shell {
    position: relative;
    z-index: 1;
    width: min(1100px, calc(100% - 48px));
    margin: 0 auto;
    padding: 32px 0 112px;
  }

  .teaching-sections {
    display: grid;
    gap: 20px;
    width: min(100%, 980px);
    margin: 0 auto;
  }

  .publication-card {
    position: relative;
    padding: 24px 26px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card-bg);
    box-shadow: 0 10px 28px var(--shadow);
  }

  .publication-card::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: var(--card-edge);
    box-shadow: 1px 0 8px var(--card-edge);
    pointer-events: none;
  }

  .publication-card h2 {
    margin: 0 0 9px;
    font-size: 1.2rem;
    color: var(--heading);
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 13px;
    margin-bottom: 2px;
    border-bottom: 1px solid var(--divider);
  }

  .card-header h2 {
    margin: 0;
  }

  .drp-info {
    flex: 0 0 auto;
    margin: 0;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .drp-info a {
    color: var(--link);
    text-underline-offset: 2px;
  }

  .drp-info a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .record-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .record-list li {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--divider);
  }
  .background-caption {
    position: absolute;
    right: 0;
    bottom: 58px;
    margin: 0;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: normal;
    color: var(--caption);
    text-align: right;
    text-shadow: 0 1px 2px var(--caption-shadow);
  }

  .record-list li:first-child {
    border-top: 0;
  }

  .record-list li:last-child {
    padding-bottom: 0;
  }

  .term {
    padding-top: 2px;
    color: var(--date-accent, var(--accent));
  }

  .entry-details {
    display: grid;
    gap: 3px;
    color: var(--text);
    line-height: 1.5;
  }

  .mentee {
    color: var(--text);
    font-weight: 400;
  }

  .topic {
    color: var(--muted);
    font-style: italic;
  }

  .ta-columns {
    overflow-x: auto;
  }

  .ta-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .ta-table tr + tr {
    border-top: 1px solid var(--ta-divider);
  }

  .ta-table td {
    padding: 10px 0;
    line-height: 1.5;
    text-align: left;
    vertical-align: top;
  }

  .ta-table td:first-child {
    width: 20%;
    white-space: nowrap;
  }

  .ta-table td:nth-child(2) {
    width: 20%;
    padding-left: clamp(32px, 4vw, 44px);
    white-space: nowrap;
  }

  .ta-table td:last-child {
    width: 60%;
    padding-left: clamp(40px, 5vw, 56px);
  }

  .program {
    font-size: 0.78rem;
    color: var(--muted);
  }

  @media (max-width: 680px) {
    .page-shell {
      width: min(100% - 32px, 1100px);
    }

    .publication-card {
      min-width: 0;
      padding: 20px;
    }

    .card-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 3px;
    }

    .record-list li {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .term {
      padding-top: 0;
    }
  }

  /* Light mode: a cool slate ledger treatment. */
  :global(html[data-theme="light"]) {
    --bg: #d8e4e9;
    --surface: #f7fafb;
    --text: #243640;
    --heading: #294957;
    --muted: #586b75;
    --accent: #4b7280;
    --nav-accent: #4b7280;
    --date-accent: #3f7081;
    --link: #286784;
    --line: rgba(41, 73, 88, 0.46);
    --divider: rgba(41, 73, 88, 0.27);
    --ta-divider: rgba(41, 73, 88, 0.19);
    --card-edge: #547684;
    --background-overlay-start: rgba(205, 220, 226, 0.45);
    --background-overlay-end: rgba(215, 228, 233, 0.58);
    --card-bg: rgba(248, 251, 252, 0.95);
    --shadow: rgba(31, 57, 69, 0.15);
    --caption: #294957;
    --caption-shadow: rgba(247, 250, 251, 0.96);
  }

  :global(html[data-theme="light"] body.teaching-page .page-watermark)::after {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 176px;
    background: linear-gradient(
      to bottom,
      rgba(225, 235, 239, 0.46),
      rgba(225, 235, 239, 0.22) 58%,
      rgba(225, 235, 239, 0)
    );
  }

  :global(html[data-theme="light"]) .publication-card {
    min-width: 0;
    border-radius: 14px;
    box-shadow: 6px 6px 0 rgba(31, 57, 69, 0.15);
  }

  :global(html[data-theme="light"]) .publication-card::before {
    box-shadow: none;
  }

  :global(html[data-theme="light"]) .publication-card h2 {
    font-family: "STIX Two Text", Georgia, "Times New Roman", serif;
    font-size: 1.34rem;
    font-weight: 700;
    letter-spacing: -0.012em;
  }

  :global(html[data-theme="light"]) .card-header {
    padding-bottom: 15px;
    border-bottom-color: rgba(41, 73, 88, 0.42);
  }

  :global(html[data-theme="light"]) .term {
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  :global(html[data-theme="light"]) .mentee {
    color: #283c46;
    font-weight: 500;
  }

  :global(html[data-theme="light"]) .topic {
    color: #526873;
  }

  :global(html[data-theme="light"]) .background-caption {
    opacity: 0.78;
  }

  @media (max-width: 680px) {
    .ta-columns {
      max-width: 100%;
      overflow: visible;
    }

    .ta-table {
      min-width: 0;
      table-layout: auto;
    }

    .ta-table tbody {
      display: grid;
    }

    .ta-table tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 16px;
      padding: 12px 0;
    }

    .ta-table td {
      width: auto !important;
      padding: 0 !important;
      white-space: normal !important;
    }

    .ta-table td:nth-child(2) {
      white-space: nowrap !important;
    }

    .ta-table .topic {
      grid-column: 1 / -1;
    }
  }
</style>
