---
const quotations = [
  {
    text: "Lack of originality, everywhere, all over the world, from time immemorial, has always been considered the foremost quality and the best recommendation of the active, efficient and practical man…",
    work: "The Idiot",
    translation: "Translated by Richard Pevear and Larissa Volokhonsky · Everyman’s Library, 2002",
    editionUrl: "https://penguinrandomhousehighereducation.com/book/?isbn=9780375413926",
    originalUrl: "https://rvb.ru/dostoevski/01text/vol6/28-29.htm",
  },
  {
    text: "You sensed that you should be following a different path, a more ambitious one, you felt that you were destined for other things but you had no idea how to achieve them and in your misery you began to hate everything around you.",
    work: "Netochka Nezvanova",
    translation: "Translated by Jane Kentish · Penguin Classics, 1985",
    editionUrl: "https://ci.nii.ac.jp/ncid/BA24896503",
    originalUrl: "https://rvb.ru/dostoevski/01text/vol2/14-01.htm",
  },
];
---

<section id="home-quotes" class="quote-carousel" data-home-quotes aria-label="Literary quotations" aria-roledescription="carousel">
  <div class="quote-pages">
    {quotations.map((quote, index) => (
      <figure
        class:list={["quote-page", { "is-active": index === 0 }]}
        data-quote-page
        role="group"
        aria-roledescription="slide"
        aria-label={`Quotation ${index + 1} of ${quotations.length}`}
        aria-hidden={index === 0 ? "false" : "true"}
        inert={index !== 0}
      >
        <blockquote class="quote-text" cite={quote.originalUrl}>
          <p>“{quote.text}”</p>
        </blockquote>
        <figcaption class="quote-credit">
          <p class="quote-author"><span aria-hidden="true">— </span>Fyodor Dostoevsky, <cite>{quote.work}</cite></p>
          <p class="quote-edition">
            {quote.editionUrl ? <a href={quote.editionUrl} target="_blank" rel="noopener noreferrer">{quote.translation}</a> : <span>{quote.translation}</span>}
            <span class="quote-source-separator" aria-hidden="true"> · </span>
            <a href={quote.originalUrl} target="_blank" rel="noopener noreferrer">Russian original</a>
          </p>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="quote-controls" data-quote-controls hidden>
    <button class="quote-control" type="button" data-quote-previous aria-label="Show previous quotation" title="Previous quotation">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
    </button>
    <div class="quote-dots" role="group" aria-label="Choose a quotation">
      {quotations.map((quote, index) => (
        <button class="quote-dot" type="button" data-quote-dot={index} aria-label={`Show quotation ${index + 1}: ${quote.work}`} aria-pressed={index === 0 ? "true" : "false"}>
          <span aria-hidden="true"></span>
        </button>
      ))}
    </div>
    <button class="quote-control" type="button" data-quote-next aria-label="Show next quotation" title="Next quotation">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
    </button>
    <button class="quote-control quote-playback" type="button" data-quote-playback aria-label="Pause quotation slideshow" title="Pause quotation slideshow">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path data-quote-playback-icon d="M9 6v12m6-12v12" /></svg>
    </button>
  </div>
  <p class="quote-status" data-quote-status role="status" aria-live="polite" aria-atomic="true"></p>
</section>

<script>
  let initializedQuotes: HTMLElement | null = null;
  let cleanupQuotes = () => {};

  function initializeQuotes() {
    const carousel = document.querySelector<HTMLElement>("[data-home-quotes]");
    if (carousel && initializedQuotes === carousel) return;
    cleanupQuotes();
    if (!carousel) return;

    const pages = Array.from(carousel.querySelectorAll<HTMLElement>("[data-quote-page]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-quote-dot]"));
    const controls = carousel.querySelector<HTMLElement>("[data-quote-controls]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-quote-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-quote-next]");
    const playback = carousel.querySelector<HTMLButtonElement>("[data-quote-playback]");
    const icon = playback?.querySelector<SVGPathElement>("[data-quote-playback-icon]");
    const status = carousel.querySelector<HTMLElement>("[data-quote-status]");
    if (pages.length < 2 || !controls || !previous || !next || !playback) return;

    initializedQuotes = carousel;
    const controller = new AbortController();
    const { signal } = controller;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let paused = false;
    let hovering = false;
    let focused = false;
    let visible = false;
    let disposed = false;
    let timer = 0;

    function schedule() {
      window.clearTimeout(timer);
      if (disposed || paused || motion.matches || hovering || focused || !visible || document.hidden) return;
      timer = window.setTimeout(() => show(current + 1, false), 15000);
    }

    function show(index: number, announce: boolean) {
      if (disposed) return;
      current = (index + pages.length) % pages.length;
      pages.forEach((page, item) => {
        const active = item === current;
        page.classList.toggle("is-active", active);
        page.setAttribute("aria-hidden", String(!active));
        page.inert = !active;
        dots[item]?.setAttribute("aria-pressed", String(active));
      });
      if (status) status.textContent = announce ? `Quotation ${current + 1} of ${pages.length}.` : "";
      schedule();
    }

    function updatePlayback() {
      const label = paused ? "Play quotation slideshow" : "Pause quotation slideshow";
      playback!.setAttribute("aria-label", label);
      playback!.title = label;
      playback!.hidden = motion.matches;
      icon?.setAttribute("d", paused ? "m8 5 10 7-10 7z" : "M9 6v12m6-12v12");
      schedule();
    }

    previous.addEventListener("click", () => show(current - 1, true), { signal });
    next.addEventListener("click", () => show(current + 1, true), { signal });
    dots.forEach((dot, index) => dot.addEventListener("click", () => show(index, true), { signal }));
    playback.addEventListener("click", () => { paused = !paused; updatePlayback(); }, { signal });
    carousel.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse" || event.pointerType === "pen") hovering = true;
      schedule();
    }, { signal });
    carousel.addEventListener("pointerleave", () => { hovering = false; schedule(); }, { signal });
    carousel.addEventListener("focusin", () => { focused = true; schedule(); }, { signal });
    carousel.addEventListener("focusout", () => queueMicrotask(() => {
      if (disposed) return;
      focused = carousel.contains(document.activeElement);
      schedule();
    }), { signal });
    document.addEventListener("visibilitychange", schedule, { signal });
    motion.addEventListener("change", updatePlayback, { signal });

    const observer = new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.25);
      schedule();
    }, { threshold: [0, 0.25] });
    observer.observe(carousel);
    controls.hidden = false;
    show(0, false);
    updatePlayback();

    cleanupQuotes = () => {
      disposed = true;
      window.clearTimeout(timer);
      controller.abort();
      observer.disconnect();
      initializedQuotes = null;
      cleanupQuotes = () => {};
    };
  }

  initializeQuotes();
  document.addEventListener("astro:page-load", initializeQuotes);
  document.addEventListener("astro:before-swap", () => cleanupQuotes());
</script>

<style>
  .quote-carousel {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    box-sizing: border-box;
    width: calc(100vw - 48px);
    min-width: 0;
    margin: 0;
    padding: 24px clamp(24px, 4vw, 48px) 10px;
    border: 1px solid rgba(95, 122, 82, .24);
    border-radius: 22px;
    background: linear-gradient(130deg, rgba(235, 241, 228, .98), rgba(214, 226, 206, .97));
    box-shadow: 0 18px 42px rgba(63, 85, 53, .14), 0 3px 9px rgba(63, 85, 53, .07);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #493b32;
    isolation: isolate;
  }
  :global(html[data-theme="dark"]) .quote-carousel {
    border-color: rgba(181, 180, 163, .22);
    background: linear-gradient(130deg, rgba(52, 53, 48, .98), rgba(39, 42, 39, .98));
    box-shadow: 0 18px 42px rgba(0, 0, 0, .25), 0 3px 9px rgba(0, 0, 0, .14);
    color: #eeece3;
  }
  .quote-carousel .quote-pages { display: grid; max-width: 1110px; margin: 0 auto; min-width: 0; }
  .quote-carousel .quote-page {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 600ms ease, visibility 0s 600ms;
  }
  .quote-carousel .quote-page.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 600ms ease, visibility 0s;
  }
  .quote-carousel .quote-text { margin: 0; padding: 0; border: 0; color: inherit; }
  .quote-carousel .quote-text p {
    margin: 0;
    color: inherit;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }
  .quote-carousel .quote-credit { padding-top: 12px; margin-top: auto; text-align: right; }
  .quote-carousel .quote-author {
    margin: 0 0 4px;
    color: inherit;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: 15px;
    line-height: 1.45;
    font-style: italic;
    font-weight: 400;
  }
  .quote-carousel .quote-author cite { font: inherit; }
  .quote-carousel .quote-edition {
    margin: 0;
    color: #705849;
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 12.5px;
    line-height: 1.6;
    font-weight: 400;
    font-style: normal;
    overflow-wrap: break-word;
  }
  :global(html[data-theme="dark"]) .quote-carousel .quote-edition { color: #c7c5b9; }
  .quote-carousel .quote-edition a { color: inherit; font: inherit; text-decoration: none; text-underline-offset: 3px; }
  .quote-carousel .quote-edition a:hover,
  .quote-carousel .quote-edition a:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; }
  .quote-carousel .quote-controls { display: flex; justify-content: center; align-items: center; gap: 7px; margin: 9px 0 0; }
  .quote-carousel [hidden] { display: none !important; }
  .quote-carousel .quote-control,
  .quote-carousel .quote-dot {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    flex: none;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #8b604a;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  :global(html[data-theme="dark"]) .quote-carousel .quote-control,
  :global(html[data-theme="dark"]) .quote-carousel .quote-dot { color: #ccc8b8; }
  .quote-carousel .quote-control:hover,
  .quote-carousel .quote-dot:hover { background: rgba(163, 107, 76, .15); }
  .quote-carousel button:focus-visible,
  .quote-carousel a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .quote-carousel .quote-control svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .quote-carousel .quote-dots { display: flex; align-items: center; gap: 0; }
  .quote-carousel .quote-dot { width: 24px; }
  .quote-carousel .quote-dot span { width: 6px; height: 6px; border: 1px solid currentColor; border-radius: 50%; }
  .quote-carousel .quote-dot[aria-pressed="true"] span { background: currentColor; }
  .quote-carousel .quote-playback { margin-left: 9px; }
  .quote-carousel .quote-status { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 680px) {
    .quote-carousel { width: calc(100vw - 32px); padding: 20px 20px 10px; border-radius: 17px; }
    .quote-carousel .quote-credit { padding-top: 12px; text-align: left; }
    .quote-carousel .quote-source-separator { display: none; }
    .quote-carousel .quote-edition > a:last-child { display: block; margin-top: 3px; }
    .quote-carousel .quote-controls { margin-top: 8px; }
  }
  @media (pointer: coarse) {
    .quote-carousel .quote-control { width: 44px; height: 44px; }
    .quote-carousel .quote-dot { width: 36px; height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .quote-carousel .quote-page,
    .quote-carousel .quote-page.is-active { transition: none; }
  }
</style>
