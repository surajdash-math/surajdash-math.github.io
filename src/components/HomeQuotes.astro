---
const quotations = [
  {
    text: "Lack of originality, everywhere, all over the world, from time immemorial, has always been considered the foremost quality and the best recommendation of the active, efficient and practical man…",
    work: "The Idiot",
    theme: "light",
    translation: "Translated by Richard Pevear and Larissa Volokhonsky · Everyman’s Library, 2002",
    editionUrl: "https://penguinrandomhousehighereducation.com/book/?isbn=9780375413926",
    originalUrl: "https://rvb.ru/dostoevski/01text/vol6/28-29.htm",
  },
  {
    text: "You sensed that you should be following a different path, a more ambitious one, you felt that you were destined for other things but you had no idea how to achieve them and in your misery you began to hate everything around you.",
    work: "Netochka Nezvanova",
    theme: "dark",
    translation: "Translated by Jane Kentish · Penguin Classics, 1985",
    editionUrl: "https://ci.nii.ac.jp/ncid/BA24896503",
    originalUrl: "https://rvb.ru/dostoevski/01text/vol2/14-01.htm",
  },
];
---

<section id="home-quotes" class="quote-card" data-home-quotes aria-label="Literary quotations">
  <div class="quote-pages">
    {quotations.map((quote) => (
      <figure
        class="quote-page"
        data-quote-page
        data-quote-theme={quote.theme}
      >
        <blockquote class="quote-text" cite={quote.originalUrl}>
          <p>“{quote.text}”</p>
        </blockquote>
        <figcaption class="quote-credit">
          <p class="quote-author"><span aria-hidden="true">— </span>Fyodor Dostoevsky, <cite>{quote.work}</cite></p>
          <p class="quote-edition">
            {quote.editionUrl ? <a href={quote.editionUrl} target="_blank" rel="noopener noreferrer">{quote.translation}</a> : <span>{quote.translation}</span>}
            <span class="quote-source-separator" aria-hidden="true"> · </span>
            <a href={quote.originalUrl} target="_blank" rel="noopener noreferrer">Russian original</a>
          </p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .quote-card {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    box-sizing: border-box;
    width: calc(100vw - 48px);
    min-width: 0;
    margin: 0;
    padding: 24px clamp(24px, 4vw, 48px);
    border: 1px solid rgba(95, 122, 82, .24);
    border-radius: 22px;
    background: linear-gradient(130deg, rgba(235, 241, 228, .98), rgba(214, 226, 206, .97));
    box-shadow: 0 18px 42px rgba(63, 85, 53, .14), 0 3px 9px rgba(63, 85, 53, .07);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #35434a;
    isolation: isolate;
  }
  :global(html[data-theme="dark"]) .quote-card {
    border-color: rgba(181, 180, 163, .22);
    background: linear-gradient(130deg, rgba(52, 53, 48, .98), rgba(39, 42, 39, .98));
    box-shadow: 0 18px 42px rgba(0, 0, 0, .25), 0 3px 9px rgba(0, 0, 0, .14);
    color: #eeece3;
  }
  .quote-card .quote-pages { display: grid; max-width: 1110px; margin: 0 auto; min-width: 0; }
  .quote-card .quote-page {
    grid-area: 1 / 1;
    display: none;
    flex-direction: column;
    min-width: 0;
    margin: 0;
  }
  :global(html:not([data-theme="dark"])) .quote-page[data-quote-theme="light"],
  :global(html[data-theme="dark"]) .quote-page[data-quote-theme="dark"] {
    display: flex;
  }
  .quote-card .quote-text { margin: 0; padding: 0; border: 0; color: inherit; }
  .quote-card .quote-text p {
    margin: 0;
    color: inherit;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: 19px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }
  .quote-card .quote-credit { padding-top: 12px; margin-top: auto; text-align: right; }
  .quote-card .quote-author {
    margin: 0 0 4px;
    color: inherit;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: 15px;
    line-height: 1.45;
    font-style: italic;
    font-weight: 400;
  }
  .quote-card .quote-author cite { font: inherit; }
  .quote-card .quote-edition {
    margin: 0;
    color: #405e6a;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: 15px;
    line-height: 1.6;
    font-weight: 400;
    font-style: normal;
    overflow-wrap: break-word;
  }
  :global(html[data-theme="dark"]) .quote-card .quote-edition { color: #c7c5b9; }
  .quote-card .quote-edition a { color: inherit; font: inherit; text-decoration: none; text-underline-offset: 3px; }
  .quote-card .quote-edition a:hover,
  .quote-card .quote-edition a:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; }
  .quote-card a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (max-width: 680px) {
    .quote-card { width: calc(100vw - 32px); padding: 20px; border-radius: 17px; }
    .quote-card .quote-credit { padding-top: 12px; text-align: left; }
    .quote-card .quote-source-separator { display: none; }
    .quote-card .quote-edition > a:last-child { display: block; margin-top: 3px; }
  }
</style>
