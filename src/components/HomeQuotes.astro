---
const quotations = [
  {
    text: "Lack of originality, everywhere, all over the world, from time immemorial, has always been considered the foremost quality and the best recommendation of the active, efficient and practical man…",
    work: "The Idiot",
    theme: "light",
    translation: "Translated by Richard Pevear and Larissa Volokhonsky",
    editionUrl: "https://penguinrandomhousehighereducation.com/book/?isbn=9780375413926",
    originalUrl: "https://rvb.ru/dostoevski/01text/vol6/28-29.htm",
  },
  {
    text: "You sensed that you should be following a different path, a more ambitious one, you felt that you were destined for other things but you had no idea how to achieve them and in your misery you began to hate everything around you.",
    work: "Netochka Nezvanova",
    theme: "dark",
    translation: "Translated by Jane Kentish",
    editionUrl: "https://ci.nii.ac.jp/ncid/BA24896503",
    originalUrl: "https://rvb.ru/dostoevski/01text/vol2/14-01.htm",
  },
];
---

<section id="home-quotes" class="quote-card" data-home-quotes aria-label="Literary quotations" aria-roledescription="carousel">
  <div class="quote-pages">
    {quotations.map((quote, index) => (
      <figure
        class:list={["quote-page", { "is-active": index === 0 }]}
        data-quote-page
        role="group"
        aria-roledescription="slide"
        aria-label={`Quotation ${index + 1} of ${quotations.length}`}
        aria-hidden={index === 0 ? "false" : "true"}
        inert={index !== 0}
      >
        <blockquote class="quote-text" cite={quote.originalUrl}>
          <p>“{quote.text}”</p>
        </blockquote>
        <figcaption class="quote-credit">
          <p class="quote-author"><span aria-hidden="true">— </span>Fyodor Dostoevsky, <cite>{quote.work}</cite></p>
          <p class="quote-edition">
            {quote.editionUrl ? <a href={quote.editionUrl} target="_blank" rel="noopener noreferrer">{quote.translation}</a> : <span>{quote.translation}</span>}
            <span class="quote-source-separator" aria-hidden="true"> · </span>
            <a href={quote.originalUrl} target="_blank" rel="noopener noreferrer">Russian original</a>
          </p>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="quote-controls">
    <span data-quote-position aria-live="off">1 / {quotations.length}</span>
    <button type="button" data-quote-playback aria-label="Pause quotation rotation">Pause</button>
    <button type="button" data-quote-next aria-label="Show the next quotation">Next</button>
  </div>
</section>

<script>
  let initializedQuotes: HTMLElement | null = null;
  let cleanupQuotes = () => {};

  function initializeQuotes() {
    const carousel = document.querySelector<HTMLElement>("[data-home-quotes]");
    if (carousel && initializedQuotes === carousel) return;
    cleanupQuotes();
    if (!carousel) return;

    const pages = Array.from(carousel.querySelectorAll<HTMLElement>("[data-quote-page]"));
    const playback = carousel.querySelector<HTMLButtonElement>("[data-quote-playback]")!;
    const next = carousel.querySelector<HTMLButtonElement>("[data-quote-next]")!;
    const position = carousel.querySelector<HTMLElement>("[data-quote-position]")!;
    if (pages.length < 2) return;

    initializedQuotes = carousel;
    const controller = new AbortController();
    const { signal } = controller;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let paused = motion.matches;
    let current = 0;
    let hovering = false;
    let focused = false;
    let visible = false;
    let disposed = false;
    let timer = 0;

    function schedule() {
      window.clearTimeout(timer);
      if (disposed || paused || motion.matches || hovering || focused || !visible || document.hidden) return;
      timer = window.setTimeout(() => show(current + 1), 15000);
    }

    function show(index: number) {
      if (disposed) return;
      current = (index + pages.length) % pages.length;
      pages.forEach((page, item) => {
        const active = item === current;
        page.classList.toggle("is-active", active);
        page.setAttribute("aria-hidden", String(!active));
        page.inert = !active;
      });
      position.textContent = `${current + 1} / ${pages.length}`;
      schedule();
    }

    function syncPlayback() {
      playback.textContent = paused ? "Play" : "Pause";
      playback.setAttribute("aria-label", paused ? "Resume quotation rotation" : "Pause quotation rotation");
    }
    playback.addEventListener("click", () => { paused = !paused; syncPlayback(); schedule(); }, { signal });
    next.addEventListener("click", () => show(current + 1), { signal });

    carousel.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse" || event.pointerType === "pen") hovering = true;
      schedule();
    }, { signal });
    carousel.addEventListener("pointerleave", () => { hovering = false; schedule(); }, { signal });
    carousel.addEventListener("focusin", () => { focused = true; schedule(); }, { signal });
    carousel.addEventListener("focusout", () => queueMicrotask(() => {
      if (disposed) return;
      focused = carousel.contains(document.activeElement);
      schedule();
    }), { signal });
    document.addEventListener("visibilitychange", schedule, { signal });
    motion.addEventListener("change", () => { if (motion.matches) paused = true; syncPlayback(); schedule(); }, { signal });

    const observer = new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.25);
      schedule();
    }, { threshold: [0, 0.25] });
    observer.observe(carousel);
    syncPlayback();
    show(0);

    cleanupQuotes = () => {
      disposed = true;
      window.clearTimeout(timer);
      controller.abort();
      observer.disconnect();
      initializedQuotes = null;
      cleanupQuotes = () => {};
    };
  }

  initializeQuotes();
  document.addEventListener("astro:page-load", initializeQuotes);
  document.addEventListener("astro:before-swap", () => cleanupQuotes());
</script>

<style>
  .quote-card {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    box-sizing: border-box;
    width: calc(100vw - 48px);
    min-width: 0;
    margin: 0;
    padding: 24px clamp(24px, 4vw, 48px);
    border: 1px solid rgba(95, 122, 82, .24);
    border-radius: 22px;
    background: linear-gradient(130deg, rgba(235, 241, 228, .98), rgba(214, 226, 206, .97));
    box-shadow: 0 18px 42px rgba(63, 85, 53, .14), 0 3px 9px rgba(63, 85, 53, .07);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #35434a;
    isolation: isolate;
  }
  :global(html[data-theme="dark"]) .quote-card {
    border-color: rgba(181, 180, 163, .22);
    background: linear-gradient(130deg, rgba(52, 53, 48, .98), rgba(39, 42, 39, .98));
    box-shadow: 0 18px 42px rgba(0, 0, 0, .25), 0 3px 9px rgba(0, 0, 0, .14);
    color: #eeece3;
  }
  .quote-card .quote-pages { display: grid; max-width: 1110px; margin: 0 auto; min-width: 0; }
  .quote-card .quote-page {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 600ms ease, visibility 0s 600ms;
  }
  .quote-card .quote-page.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 600ms ease, visibility 0s;
  }
  .quote-card .quote-text { margin: 0; padding: 0; border: 0; color: inherit; }
  .quote-card .quote-text p {
    margin: 0;
    color: inherit;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: 19px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }
  .quote-card .quote-credit { padding-top: 12px; margin-top: auto; text-align: right; }
  .quote-card .quote-author {
    margin: 0 0 4px;
    color: inherit;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: 15px;
    line-height: 1.45;
    font-style: italic;
    font-weight: 400;
  }
  .quote-card .quote-author cite { font: inherit; }
  .quote-card .quote-edition {
    margin: 0;
    color: #405e6a;
    font-family: "STIX Two Text", Georgia, serif;
    font-size: 15px;
    line-height: 1.6;
    font-weight: 400;
    font-style: normal;
    overflow-wrap: break-word;
  }
  :global(html[data-theme="dark"]) .quote-card .quote-edition { color: #c7c5b9; }
  .quote-controls { display: flex; justify-content: flex-end; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 18px; font: 400 .875rem/1.4 "DM Sans",sans-serif; }
  .quote-controls > span { margin-right: 6px; font-variant-numeric: tabular-nums; }
  .quote-controls button { border: 1px solid currentColor; border-radius: 3px; background: transparent; color: inherit; min-height: 36px; padding: 6px 13px; cursor: pointer; font: inherit; }
  .quote-controls button:hover { background: #ffffff25; }
  .quote-controls button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .quote-card .quote-edition a { color: inherit; font: inherit; text-decoration: none; text-underline-offset: 3px; }
  .quote-card .quote-edition a:hover,
  .quote-card .quote-edition a:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; }
  .quote-card a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (max-width: 680px) {
    .quote-card { width: calc(100vw - 32px); padding: 20px; border-radius: 17px; }
    .quote-card .quote-credit { padding-top: 12px; text-align: left; }
    .quote-card .quote-source-separator { display: none; }
    .quote-card .quote-edition > a:last-child { display: block; margin-top: 3px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .quote-card .quote-page,
    .quote-card .quote-page.is-active { transition: none; }
  }
</style>
