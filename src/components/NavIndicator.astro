<span class="nav-indicator" aria-hidden="true"></span>

<script>
  let cleanupNavIndicators = () => {};
  let initializedNav: HTMLElement | null = null;

  function initializeNavIndicators() {
    const nav = document.querySelector<HTMLElement>(".top-nav");
    if (nav && initializedNav === nav) return;
    cleanupNavIndicators();
    if (!nav) return;
    initializedNav = nav;
    const controller = new AbortController();
    const { signal } = controller;
    const transitionFrames = new Set<number>();

    function getNavLink(target: EventTarget | null) {
      return target instanceof Element
        ? target.closest<HTMLAnchorElement>(".top-nav a")
        : null;
    }

    function moveIndicator(
      nav: HTMLElement,
      link: HTMLAnchorElement,
      animate = true,
    ) {
      const indicator = nav.querySelector<HTMLElement>(".nav-indicator");
      if (!indicator) return;

      const navRect = nav.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();

      if (!animate) indicator.classList.add("nav-indicator-no-transition");

      indicator.style.setProperty("--nav-indicator-x", `${linkRect.left - navRect.left}px`);
      indicator.style.setProperty("--nav-indicator-y", `${linkRect.bottom - navRect.top + 2}px`);
      indicator.style.setProperty("--nav-indicator-width", `${linkRect.width}px`);
      nav.classList.add("nav-indicator-ready");

      if (!animate) {
        const frame = requestAnimationFrame(() => {
          transitionFrames.delete(frame);
          indicator.classList.remove("nav-indicator-no-transition");
        });
        transitionFrames.add(frame);
      }
    }

    function restoreActiveIndicator(nav: HTMLElement, animate = true) {
      const active = nav.querySelector<HTMLAnchorElement>('a[aria-current="page"]');
      if (active) moveIndicator(nav, active, animate);
    }

    function normalizePath(pathname: string) {
      const normalized = pathname.replace(/\/+$/, "");
      return normalized || "/";
    }

    function syncActiveLink(nav: HTMLElement) {
      const currentPath = normalizePath(window.location.pathname);

      nav.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
        const isCurrent = normalizePath(new URL(link.href).pathname) === currentPath;
        if (isCurrent) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }

    function setActiveLink(nav: HTMLElement, active: HTMLAnchorElement) {
      nav.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
        if (link === active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }

    function setupNavIndicators(animate = false) {
      document.querySelectorAll<HTMLElement>(".top-nav").forEach((nav) => {
        const canAnimate = animate && nav.classList.contains("nav-indicator-ready");
        syncActiveLink(nav);
        restoreActiveIndicator(nav, canAnimate);
      });
    }

    // Keep the indicator on a tapped link while the browser follows it, and
    // restore the current-page indicator if that navigation is cancelled.
    let pendingNavigation: AbortSignal | null = null;
    let navigationLockTimer = 0;

    function lockNavigationTarget(nav: HTMLElement, link: HTMLAnchorElement) {
      window.clearTimeout(navigationLockTimer);
      setActiveLink(nav, link);
      moveIndicator(nav, link);

      // Recover if a touch starts on a link but is cancelled before navigation.
      navigationLockTimer = window.setTimeout(() => {
        if (!pendingNavigation || pendingNavigation.aborted) setupNavIndicators(false);
      }, 1200);
    }

    document.addEventListener("astro:before-preparation", (event) => {
      pendingNavigation = event.signal;
      window.clearTimeout(navigationLockTimer);
      event.signal.addEventListener("abort", () => {
        if (pendingNavigation !== event.signal) return;
        pendingNavigation = null;
        setupNavIndicators(false);
      }, { once: true, signal });
    }, { signal });

    document.addEventListener("pointerdown", (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey ||
        event.shiftKey
      ) return;

      const link = getNavLink(event.target);
      const nav = link?.closest<HTMLElement>(".top-nav");
      if (link && nav) lockNavigationTarget(nav, link);
    }, { capture: true, signal });

    document.addEventListener("click", (event) => {
      if (
        !(event instanceof MouseEvent) ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey ||
        event.shiftKey
      ) return;

      const link = getNavLink(event.target);
      const nav = link?.closest<HTMLElement>(".top-nav");
      if (!link || !nav) return;

      lockNavigationTarget(nav, link);
    }, { capture: true, signal });

    let resizeFrame = 0;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => setupNavIndicators(false));
    }, { signal });

    setupNavIndicators(false);
    cleanupNavIndicators = () => {
      controller.abort();
      window.clearTimeout(navigationLockTimer);
      cancelAnimationFrame(resizeFrame);
      transitionFrames.forEach((frame) => cancelAnimationFrame(frame));
      transitionFrames.clear();
      pendingNavigation = null;
      initializedNav = null;
      cleanupNavIndicators = () => {};
    };
  }

  initializeNavIndicators();
  document.addEventListener("astro:page-load", initializeNavIndicators);
  document.addEventListener("astro:before-swap", () => cleanupNavIndicators());
</script>

<style is:global>
  .top-nav a {
    transition: color 160ms ease;
  }

  .nav-indicator {
    --nav-indicator-x: 0px;
    --nav-indicator-y: 0px;
    --nav-indicator-width: 0px;
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    width: var(--nav-indicator-width);
    height: 4px;
    border-radius: 999px;
    background: var(--site-nav-active, var(--nav-accent, var(--accent)));
    opacity: 0;
    pointer-events: none;
    transform: translate3d(var(--nav-indicator-x), var(--nav-indicator-y), 0);
    transition:
      transform 210ms cubic-bezier(0.22, 1, 0.36, 1),
      width 210ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      opacity 120ms ease;
  }

  .top-nav.nav-indicator-ready .nav-indicator {
    opacity: 1;
  }

  .top-nav.nav-indicator-ready a[aria-current="page"] {
    text-decoration: none !important;
  }

  .nav-indicator-no-transition {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-indicator,
    .top-nav a {
      transition: none;
    }
  }

</style>
