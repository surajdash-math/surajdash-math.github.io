---
const photos = [
  {
    src: "/front-page-2-display.jpg",
    sourceType: "image/webp",
    desktopSrcset:
      "/front-page-2-desktop-768w.webp 768w, /front-page-2-desktop-1280w.webp 1280w, /front-page-2-desktop-2040w.webp 2040w, /front-page-2-desktop-3200w.webp 3200w",
    mobileSrcset:
      "/front-page-2-mobile-480w.webp 480w, /front-page-2-mobile-768w.webp 768w",
    alt: "Sunlit trees reflected across a calm lake",
    position: "50% 58%",
    tone: "lake",
  },
  {
    src: "/front-page-1-desktop-2040w.jpg",
    sourceType: "image/jpeg",
    desktopSrcset:
      "/front-page-1-desktop-768w.jpg 768w, /front-page-1-desktop-1280w.jpg 1280w, /front-page-1-desktop-2040w.jpg 2040w, /front-page-1-desktop-3200w.jpg 3200w",
    mobileSrcset:
      "/front-page-1-mobile-480w.jpg 480w, /front-page-1-desktop-768w.jpg 768w",
    alt: "Golden-hour trees reflected across Lake Austin beneath a pale sky",
    position: "50% 55%",
    tone: "lake",
  },
  {
    src: "/front-page-3-display.jpg",
    sourceType: "image/webp",
    desktopSrcset:
      "/front-page-3-desktop-768w.webp 768w, /front-page-3-desktop-1280w.webp 1280w, /front-page-3-desktop-2040w.webp 2040w, /front-page-3-desktop-3200w.webp 3200w",
    mobileSrcset:
      "/front-page-3-mobile-480w.webp 480w, /front-page-3-mobile-768w.webp 768w",
    alt: "Tree silhouettes beneath a vivid orange evening sky",
    position: "50% 62%",
    tone: "sunset",
  },
];
---

<section
  class="front-page-gallery"
  data-front-page-gallery
  aria-label="Landscape photographs"
>
  <div class="gallery-pages">
    {photos.map((photo, index) => (
      <figure
        class:list={["gallery-page", { "is-active": index === 0 }]}
        data-gallery-page
        data-hero-tone={photo.tone}
        aria-hidden={index === 0 ? "false" : "true"}
      >
        <picture>
          <source
            media="(max-width: 680px)"
            type={photo.sourceType}
            srcset={index === 0 ? photo.mobileSrcset : undefined}
            data-srcset={index === 0 ? undefined : photo.mobileSrcset}
            sizes="100vw"
          />
          <source
            type={photo.sourceType}
            srcset={index === 0 ? photo.desktopSrcset : undefined}
            data-srcset={index === 0 ? undefined : photo.desktopSrcset}
            sizes="100vw"
          />
          <img
            src={index === 0 ? photo.src : undefined}
            data-src={index === 0 ? undefined : photo.src}
            alt={photo.alt}
            width="2040"
            height="1530"
            style={`object-position: ${photo.position};`}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "low"}
            decoding="async"
          />
        </picture>
        <figcaption>
          <a
            class="location-link"
            href="https://www.google.com/maps/search/?api=1&amp;query=614%20N%20Commons%20Ford%20Rd%2C%20Austin%2C%20TX%2078733"
            target="_blank"
            rel="noreferrer"
            aria-label="Open 614 N Commons Ford Rd, Austin, TX 78733 in Google Maps"
            title="614 N Commons Ford Rd, Austin, TX 78733"
          ><span aria-hidden="true">📍</span></a>
          <span>Lake Austin, Texas</span>
        </figcaption>
      </figure>
    ))}

    <button
      class="playback-toggle"
      type="button"
      data-gallery-playback
      aria-label="Pause photograph slideshow"
      title="Pause photograph slideshow"
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path data-playback-icon d="M9 6v12m6-12v12"></path>
      </svg>
    </button>

    <button
      class="turn-tab"
      type="button"
      data-gallery-next
      aria-label="Show the next photograph"
      title="Show the next photograph"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m9 5 7 7-7 7"></path>
      </svg>
    </button>

    <a class="scroll-cue" href="#profile" aria-label="Continue to the introduction" title="About me">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m5 9 7 7 7-7"></path>
      </svg>
    </a>

    <p class="gallery-status" role="status" data-gallery-status aria-live="polite" aria-atomic="true">
      Photograph 1 of {photos.length}: {photos[0].alt}. Lake Austin, Texas.
    </p>
  </div>
</section>

<script>
  let cleanupFrontPageGallery = () => {};
  let initializedGallery: HTMLElement | null = null;

  function setupFrontPageGallery() {
    const gallery = document.querySelector<HTMLElement>("[data-front-page-gallery]");
    if (gallery && initializedGallery === gallery) return;
    cleanupFrontPageGallery();
    if (!gallery || gallery.dataset.ready === "true") return;

    const pages = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-page]"));
    const nextButton = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const playbackButton = gallery.querySelector<HTMLButtonElement>("[data-gallery-playback]");
    const playbackIcon = playbackButton?.querySelector<SVGPathElement>("[data-playback-icon]");
    const status = gallery.querySelector<HTMLElement>("[data-gallery-status]");
    if (pages.length < 2 || !nextButton || !playbackButton) return;

    const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
    const autoplayDelay = 5000;

    const controller = new AbortController();
    const { signal } = controller;
    let disposed = false;
    initializedGallery = gallery;
    gallery.dataset.ready = "true";
    let current = 0;
    let isTurning = false;
    let preloadTimer = 0;
    let toneTimer = 0;
    let fallbackTimer = 0;
    let autoplayTimer = 0;
    let isPaused = motionPreference.matches;
    let isGalleryVisible = true;
    let firstImageReady = false;
    let visibilityObserver: IntersectionObserver | null = null;

    cleanupFrontPageGallery = () => {
      disposed = true;
      controller.abort();
      window.clearTimeout(preloadTimer);
      window.clearTimeout(toneTimer);
      window.clearTimeout(fallbackTimer);
      window.clearTimeout(autoplayTimer);
      visibilityObserver?.disconnect();
      nextButton.onclick = null;
      playbackButton.onclick = null;
      delete gallery.dataset.ready;
      initializedGallery = null;
      cleanupFrontPageGallery = () => {};
    };

    const applyHeroTone = (page: HTMLElement) => {
      const tone = page.dataset.heroTone ?? "lake";
      document.documentElement.dataset.heroTone = tone;
      const header = document.querySelector<HTMLElement>(".site-header");
      if (header) header.dataset.heroTone = tone;
    };

    applyHeroTone(pages[current]);

    const getPageImage = (page: HTMLElement) => page.querySelector<HTMLImageElement>("img");

    const promotePageSources = (page: HTMLElement) => {
      page.querySelectorAll<HTMLSourceElement>("source[data-srcset]").forEach((source) => {
        const srcset = source.dataset.srcset;
        if (!srcset) return;
        source.srcset = srcset;
        delete source.dataset.srcset;
      });

      const image = getPageImage(page);
      const src = image?.dataset.src;
      if (image && src) {
        image.src = src;
        delete image.dataset.src;
      }
    };

    const primePage = (page: HTMLElement) => {
      const image = getPageImage(page);
      if (!image) return;
      image.loading = "eager";
      image.fetchPriority = "low";
      promotePageSources(page);
    };

    const canAutoplay = () => !isPaused && !document.hidden && isGalleryVisible;

    const scheduleAutoplay = () => {
      window.clearTimeout(autoplayTimer);
      if (disposed || !firstImageReady || isTurning || !canAutoplay()) return;
      autoplayTimer = window.setTimeout(() => void advancePhoto(false), autoplayDelay);
    };

    const updatePlaybackControl = () => {
      const label = isPaused ? "Play photograph slideshow" : "Pause photograph slideshow";
      playbackButton.setAttribute("aria-label", label);
      playbackButton.title = label;
      playbackButton.hidden = false;
      playbackIcon?.setAttribute("d", isPaused ? "m8 5 10 7-10 7z" : "M9 6v12m6-12v12");
      status?.setAttribute("aria-live", isPaused ? "polite" : "off");
      scheduleAutoplay();
    };

    const firstImage = getPageImage(pages[current]);
    const primeAlternate = () => {
      firstImageReady = true;
      scheduleAutoplay();
      preloadTimer = window.setTimeout(() => {
        if (!disposed && gallery.isConnected) primePage(pages[1]);
      }, 120);
    };
    if (firstImage?.complete) primeAlternate();
    else {
      firstImage?.addEventListener("load", primeAlternate, { once: true, signal });
      firstImage?.addEventListener("error", primeAlternate, { once: true, signal });
    }

    const ensurePageReady = async (page: HTMLElement): Promise<boolean> => {
      const image = getPageImage(page);
      if (!image) return false;

      if (image.complete && image.naturalWidth > 0) {
        try {
          await image.decode();
        } catch {
          // A fully loaded fallback can still be displayed if decoding rejects.
        }
        return true;
      }

      return new Promise<boolean>((resolve) => {
        let settled = false;

        const cleanup = () => {
          image.removeEventListener("load", onLoad);
          image.removeEventListener("error", onError);
          signal.removeEventListener("abort", onAbort);
        };

        const finish = async (success: boolean) => {
          if (settled) return;
          settled = true;
          cleanup();
          if (success) {
            try {
              await image.decode();
            } catch {
              // The loaded image remains usable even if explicit decoding rejects.
            }
          }
          resolve(success);
        };

        const onLoad = () => void finish(true);
        const onError = () => void finish(false);
        const onAbort = () => void finish(false);
        signal.addEventListener("abort", onAbort, { once: true });
        image.addEventListener("load", onLoad, { once: true, signal });
        image.addEventListener("error", onError, { once: true, signal });
        primePage(page);

        if (image.complete) void finish(image.naturalWidth > 0);
      });
    };

    const advancePhoto = async (announce: boolean) => {
      if (disposed || isTurning || (!announce && !canAutoplay())) return;

      window.clearTimeout(autoplayTimer);
      status?.setAttribute("aria-live", announce ? "polite" : "off");
      isTurning = true;
      const outgoing = pages[current];
      const next = (current + 1) % pages.length;
      const incoming = pages[next];
      gallery.setAttribute("aria-busy", "true");
      nextButton.setAttribute("aria-busy", "true");
      const ready = await ensurePageReady(incoming);

      if (disposed || !gallery.isConnected) return;
      if (!announce && !canAutoplay()) {
        gallery.removeAttribute("aria-busy");
        nextButton.removeAttribute("aria-busy");
        isTurning = false;
        scheduleAutoplay();
        return;
      }
      if (!ready) {
        gallery.removeAttribute("aria-busy");
        nextButton.removeAttribute("aria-busy");
        isTurning = false;
        isPaused = true;
        updatePlaybackControl();
        if (status) status.textContent = "The next photograph could not be loaded.";
        return;
      }

      current = next;

      incoming.classList.add("is-active");
      incoming.setAttribute("aria-hidden", "false");
      outgoing.classList.remove("is-active");
      outgoing.classList.add("is-turning");
      outgoing.setAttribute("aria-hidden", "true");

      const reducedMotion = motionPreference.matches;
      if (reducedMotion) applyHeroTone(incoming);
      else {
        toneTimer = window.setTimeout(() => {
          if (!disposed && gallery.isConnected) applyHeroTone(incoming);
        }, 340);
      }

      let finished = false;
      const finishTurn = () => {
        if (finished || disposed) return;
        finished = true;
        window.clearTimeout(fallbackTimer);
        outgoing.classList.remove("is-turning");
        gallery.removeAttribute("aria-busy");
        nextButton.removeAttribute("aria-busy");
        if (status) {
          const description = getPageImage(incoming)?.alt ?? "Landscape photograph";
          status.textContent = `Photograph ${current + 1} of ${pages.length}: ${description}. Lake Austin, Texas.`;
        }
        isTurning = false;
        scheduleAutoplay();
      };

      if (reducedMotion) {
        finishTurn();
      } else {
        outgoing.addEventListener("animationend", finishTurn, { once: true, signal });
        fallbackTimer = window.setTimeout(finishTurn, 760);
      }
    };

    nextButton.onclick = () => {
      isPaused = true;
      updatePlaybackControl();
      void advancePhoto(true);
    };

    playbackButton.onclick = () => {
      isPaused = !isPaused;
      updatePlaybackControl();
    };

    gallery.addEventListener("focusin", (event) => {
      if (event.target === playbackButton) return;
      isPaused = true;
      updatePlaybackControl();
    }, { signal });

    document.addEventListener("visibilitychange", scheduleAutoplay, { signal });
    motionPreference.addEventListener("change", (event) => {
      if (event.matches) isPaused = true;
      updatePlaybackControl();
    }, { signal });

    visibilityObserver = new IntersectionObserver(([entry]) => {
      isGalleryVisible = entry.isIntersecting && entry.intersectionRatio > 0.1;
      scheduleAutoplay();
    }, { threshold: [0, 0.1] });
    visibilityObserver.observe(gallery);
    updatePlaybackControl();
  }

  setupFrontPageGallery();
  document.addEventListener("astro:page-load", setupFrontPageGallery);
  document.addEventListener("astro:before-swap", () => cleanupFrontPageGallery());
</script>

<style>
  .front-page-gallery {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    margin: 0 0 clamp(48px, 6vw, 66px);
    overflow: hidden;
    background: #d6dde1;
  }

  :global(html[data-theme="dark"]) .front-page-gallery {
    background: #111a20;
  }

  .gallery-pages {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    perspective: 1800px;
    transform-style: preserve-3d;
  }

  .gallery-pages::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(242, 247, 249, 0.2), transparent 28%);
    transition: background 220ms ease;
  }

  :global(html[data-hero-tone="sunset"]) .gallery-pages::after,
  :global(html[data-theme="dark"]) .gallery-pages::after {
    background: linear-gradient(180deg, rgba(13, 19, 24, 0.26), transparent 30%);
  }

  .gallery-page {
    position: absolute;
    inset: 0;
    z-index: 0;
    visibility: hidden;
    margin: 0;
    opacity: 0;
    transform-origin: left center;
    backface-visibility: hidden;
  }

  .gallery-page.is-active {
    z-index: 1;
    visibility: visible;
    opacity: 1;
  }

  .gallery-page.is-turning {
    z-index: 3;
    visibility: visible;
    opacity: 1;
    animation: turn-page 620ms cubic-bezier(0.55, 0.05, 0.28, 0.98) forwards;
  }

  .gallery-page picture,
  .gallery-page img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gallery-page img {
    object-fit: cover;
    transition: filter 220ms ease;
  }

  :global(html[data-theme="dark"]) .gallery-page img {
    filter: brightness(0.72) saturate(0.9);
  }

  .gallery-page figcaption {
    position: absolute;
    left: clamp(16px, 2vw, 28px);
    bottom: clamp(16px, 2vw, 26px);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.28rem;
    color: rgba(255, 255, 255, 0.46);
    font-size: clamp(0.682rem, 0.748vw, 0.77rem);
    font-style: italic;
    letter-spacing: 0.035em;
    line-height: 1;
    text-shadow: 0 1px 4px rgba(10, 18, 22, 0.48);
  }

  .location-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    font-style: normal;
    line-height: 1;
    text-decoration: none;
    transition: transform 160ms ease;
  }

  .location-link:hover {
    transform: translateY(-1px);
  }

  .location-link:focus-visible {
    border-radius: 3px;
    outline: 1px solid rgba(255, 255, 255, 0.72);
    outline-offset: 2px;
  }

  .location-link span {
    filter: grayscale(1);
  }

  .turn-tab,
  .playback-toggle {
    position: absolute;
    right: 16px;
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 8;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    color: #fff;
    background: transparent;
    cursor: pointer;
    opacity: 0.58;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .playback-toggle {
    right: 64px;
  }

  .playback-toggle[hidden] {
    display: none;
  }

  .turn-tab::before,
  .playback-toggle::before {
    content: "";
    position: absolute;
    inset: 3px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 8px;
    background: rgba(24, 41, 50, 0.36);
    box-shadow: 0 4px 14px rgba(20, 29, 35, 0.15);
    backdrop-filter: blur(5px);
    transition: background-color 160ms ease;
  }

  .turn-tab svg,
  .playback-toggle svg {
    position: relative;
    z-index: 1;
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .turn-tab:hover,
  .playback-toggle:hover {
    opacity: 0.9;
  }

  .turn-tab:hover {
    transform: translateX(2px);
  }

  .turn-tab:hover::before,
  .playback-toggle:hover::before {
    background: rgba(24, 41, 50, 0.58);
  }

  .turn-tab:focus-visible,
  .playback-toggle:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 5px #286784;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 8;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(23, 63, 80, 0.18);
    border-radius: 50%;
    color: #173f50;
    background: #fafcfd;
    box-shadow: 0 2px 10px rgba(10, 18, 22, 0.18);
    text-decoration: none;
    transform: translateX(-50%);
    transition: color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .scroll-cue::before {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
  }

  .scroll-cue svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.5;
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    color: #fff;
    background: #286784;
  }

  .scroll-cue:hover {
    transform: translate(-50%, 2px);
  }

  .scroll-cue:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px #286784;
  }

  .gallery-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes turn-page {
    0% {
      opacity: 1;
      transform: rotateY(0deg);
      filter: brightness(1);
    }

    55% {
      opacity: 1;
      filter: brightness(0.78);
    }

    100% {
      opacity: 0;
      transform: rotateY(-105deg);
      filter: brightness(0.7);
    }
  }

  @media (max-width: 680px) {
    .front-page-gallery {
      margin-bottom: 42px;
    }

    .turn-tab,
    .playback-toggle {
      right: 8px;
      bottom: max(8px, env(safe-area-inset-bottom));
    }

    .playback-toggle {
      right: 56px;
    }

    .turn-tab::before,
    .playback-toggle::before {
      inset: 4px;
    }

    .turn-tab:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-page.is-turning {
      animation: none;
    }

    .turn-tab,
    .turn-tab::before,
    .playback-toggle,
    .playback-toggle::before,
    .scroll-cue,
    .gallery-page img,
    .gallery-pages::after {
      transition: none;
    }
  }
</style>
