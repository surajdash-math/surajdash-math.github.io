---
import NavIndicator from "./NavIndicator.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { siteBuildVersion } from "../lib/site-build-version";

interface Props {
  current: "/" | "/research" | "/teaching" | "/learning-seminars" | "/travel";
  tone?: "default" | "on-dark";
}

const { current, tone = "default" } = Astro.props;
const links = [
  { href: "/", label: "HOME" },
  { href: "/research", label: "RESEARCH" },
  { href: "/teaching", label: "TEACHING" },
  { href: "/learning-seminars", label: "SEMINARS" },
  { href: "/travel", label: "TRAVEL" },
] as const;
---

<div class="mobile-navigation" data-mobile-navigation>
  <a class="mobile-site-name" href={`/?v=${siteBuildVersion}`} aria-label="Suraj Dash — Home">Suraj Dash</a>
  <button
    class="mobile-menu-toggle"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="site-navigation-links"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
  <nav
    id="site-navigation-links"
    class:list={["top-nav", "site-navigation", { "site-navigation-on-dark": tone === "on-dark" }]}
    aria-label="Main navigation"
  >
    {links.map((link) => (
      <a
        href={`${link.href === "/" ? "/" : `${link.href}/`}?v=${siteBuildVersion}`}
        aria-current={link.href === current ? "page" : undefined}
      >{link.label}</a>
    ))}
    <NavIndicator />
    <div class="navigation-theme-control">
      <span class="mobile-theme-label">Appearance</span>
      <ThemeToggle />
    </div>
  </nav>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-mobile-navigation]").forEach((wrapper) => {
    const toggle = wrapper.querySelector<HTMLButtonElement>(".mobile-menu-toggle");
    const navigation = wrapper.querySelector<HTMLElement>(".site-navigation");
    if (!toggle || !navigation) return;

    const phoneWidth = window.matchMedia("(max-width: 680px), (max-width: 1024px) and (max-height: 500px)");

    function setOpen(open: boolean, restoreFocus = false) {
      const expanded = open && phoneWidth.matches;
      wrapper.dataset.menuOpen = String(expanded);
      toggle!.setAttribute("aria-expanded", String(expanded));
      toggle!.setAttribute("aria-label", expanded ? "Close menu" : "Open menu");
      navigation!.hidden = phoneWidth.matches && !expanded;
      navigation!.inert = phoneWidth.matches && !expanded;
      if (restoreFocus) toggle!.focus();
    }

    wrapper.dataset.menuReady = "true";
    setOpen(false);

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false, true);
      }
    });

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !wrapper.contains(event.target)) setOpen(false);
    });

    navigation.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a[href]")) setOpen(false);
    });

    phoneWidth.addEventListener("change", () => setOpen(false));
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) setOpen(false);
    });
  });
</script>

<style>
  .mobile-navigation,
  .navigation-theme-control { display: contents; }

  .mobile-site-name,
  .mobile-menu-toggle,
  .mobile-theme-label { display: none; }

  .site-navigation[hidden] { display: none; }

  .site-navigation {
    --site-nav-active: #893833;
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px;
    padding: 12px 0 56px;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-navigation a {
    color: var(--link);
    text-decoration: none;
  }

  :global(html[data-theme="light"]) .site-navigation {
    font-weight: 600;
  }

  :global(html[data-theme="dark"]) .site-navigation {
    --site-nav-active: #d17b74;
  }

  :global(html[data-theme="light"]) .site-navigation a {
    color: #174a60;
  }

  :global(html[data-theme="light"]) .site-navigation-on-dark {
    --site-nav-active: #fff0dd;
  }

  :global(html[data-theme="light"]) .site-navigation-on-dark a {
    color: #f5f8fa;
    text-shadow: 0 1px 3px rgba(11, 18, 23, 0.96), 0 0 10px rgba(11, 18, 23, 0.58);
  }

  :global(.site-header[data-hero-tone="sunset"]) .site-navigation a {
    color: #fff0dd !important;
  }

  :global(html[data-theme="light"]) .site-navigation a:hover,
  :global(html[data-theme="light"]) .site-navigation a:focus-visible,
  :global(html[data-theme="light"]) .site-navigation a[aria-current="page"] {
    color: var(--site-nav-active);
  }

  .site-navigation a:hover,
  .site-navigation a:focus-visible,
  .site-navigation a[aria-current="page"] {
    color: var(--site-nav-active);
  }

  .site-navigation a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--site-nav-active);
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.2em;
  }

  :global(.site-header[data-hero-tone="sunset"]) .site-navigation a:hover,
  :global(.site-header[data-hero-tone="sunset"]) .site-navigation a:focus-visible,
  :global(.site-header[data-hero-tone="sunset"]) .site-navigation a[aria-current="page"] {
    color: #ffd09f !important;
  }

  :global(.site-header) .site-navigation {
    padding: 0;
  }

  @media (max-width: 820px) {
    .site-navigation {
      justify-content: flex-start;
    }

    :global(.site-header) .site-navigation {
      width: 100%;
    }
  }

  @media (max-width: 680px) {
    .site-navigation {
      padding-bottom: 42px;
    }

    :global(.site-header) .site-navigation {
      padding-bottom: 0;
    }
  }

  @media (
    min-width: 681px
  ) and (
    max-width: 820px
  ) and (
    hover: none
  ) and (
    pointer: coarse
  ) {
    .site-navigation {
      width: calc(100vw - 32px);
      margin-left: calc(50% - 50vw + 16px);
    }
  }

  @media (
    min-width: 821px
  ) and (
    max-width: 1366px
  ) and (
    hover: none
  ) and (
    pointer: coarse
  ) {
    .site-navigation {
      right: calc(50% - 50vw + 16px);
    }
  }

  @media (max-width: 680px), (max-width: 1024px) and (max-height: 500px) {
    .mobile-navigation {
      --mobile-nav-active: #a7443e;
      position: relative;
      z-index: 10;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 44px;
      align-items: center;
      gap: 12px;
      width: 100%;
      margin-bottom: 32px;
      padding-top: 8px;
    }

    :global(html[data-theme="dark"]) .mobile-navigation {
      --mobile-nav-active: #d17b74;
    }

    .mobile-site-name {
      display: block;
      width: fit-content;
      color: var(--hero-header-ink, var(--heading));
      font-family: "STIX Two Text", Georgia, serif;
      font-size: clamp(2.2rem, 9.46vw, 2.805rem);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.025em;
      text-decoration: none;
      white-space: nowrap;
    }

    .mobile-navigation[data-menu-ready="true"] .mobile-menu-toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 10px;
      border: 0;
      border-radius: 6px;
      color: var(--hero-header-ink, var(--heading));
      background: transparent;
      cursor: pointer;
    }

    .mobile-menu-toggle svg {
      width: 24px;
      height: 24px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
    }

    .mobile-menu-toggle:focus-visible,
    .mobile-site-name:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }

    .mobile-navigation .site-navigation {
      grid-column: 1 / -1;
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: stretch;
      gap: 0;
      width: min(300px, 100%);
      max-height: calc(100dvh - 110px);
      overflow-y: auto;
      overscroll-behavior: contain;
      margin: 0;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--surface);
      box-shadow: 0 12px 28px var(--shadow);
    }

    .mobile-navigation[data-menu-ready="true"] .site-navigation {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
    }

    .mobile-navigation .site-navigation a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 6px 10px;
      border-radius: 6px;
    }

    :global(html[data-theme]) .mobile-navigation .site-navigation a {
      color: var(--link) !important;
      text-shadow: none !important;
    }

    :global(html[data-theme]) .mobile-navigation .site-navigation a[aria-current="page"] {
      color: var(--mobile-nav-active) !important;
      background: color-mix(in srgb, var(--mobile-nav-active) 8%, transparent);
    }

    .site-navigation.top-nav.nav-indicator-ready a[aria-current="page"] {
      text-decoration: underline !important;
      text-decoration-color: var(--mobile-nav-active);
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }

    .site-navigation :global(.nav-indicator) { display: none; }

    .navigation-theme-control {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 8px 10px 0;
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }

    .mobile-theme-label {
      display: block;
      color: var(--text);
      font-size: 0.99rem;
      font-weight: 400;
      letter-spacing: 0;
      text-transform: none;
    }

    :global(html[data-theme]) .mobile-navigation .site-navigation :global(.theme-toggle) {
      width: 44px;
      height: 44px;
      margin: 0;
      color: var(--link) !important;
      border-color: var(--line) !important;
      background: var(--surface) !important;
    }

    :global(.site-header) .mobile-navigation {
      margin-bottom: 0;
      padding-top: 0;
    }
  }

</style>
