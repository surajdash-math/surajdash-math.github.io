---
import { siteBuildVersion } from "../lib/site-build-version";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-credit">
      <p class="footer-copyright">© 2026 Suraj Dash. All rights reserved.</p>
      <p class="footer-updated">Last modified: <time datetime="2026-11-22">November 22, 2026</time>.</p>
    </div>
    <div class="footer-navigation">
      <nav class="footer-links" aria-label="Footer">
        <a href={`/copyright/?v=${siteBuildVersion}`} target="_blank" rel="noopener noreferrer">Copyright<span class="visually-hidden"> and privacy statement (opens in a new tab)</span></a>
        <a href={`/misc/?v=${siteBuildVersion}`} target="_blank" rel="noopener noreferrer">Miscellaneous<span class="visually-hidden"> (opens in a new tab)</span></a>
      </nav>
      <a class="footer-back-top" href="#" data-astro-reload>Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    box-sizing: border-box;
    flex-shrink: 0;
    width: 100vw;
    margin-top: 44px;
    border-top: 1px solid rgba(190, 210, 226, .24);
    background: linear-gradient(115deg, #293e50, #1d2b3a);
    color: #edf1f5;
    box-shadow: 0 -8px 28px rgba(26, 42, 58, .12);
  }
  :global(html[data-theme="dark"]) .site-footer {
    background: linear-gradient(115deg, #30465a, #24374b);
    border-color: rgba(190, 210, 226, .28);
    box-shadow: 0 -8px 28px rgba(0, 0, 0, .16);
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px 48px;
    width: min(1100px, calc(100% - 48px));
    margin: 0 auto;
    padding: 34px 0;
  }
  .footer-navigation { display: flex; flex-direction: column; align-items: flex-end; }
  .site-footer .footer-back-top { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; color: #bdcbd8; font-family: "DM Sans", system-ui, sans-serif; font-size: 15px; font-weight: 400; text-decoration: none; text-underline-offset: 5px; }
  .site-footer .footer-back-top:hover { color: #c6e1f1; text-decoration: underline; text-decoration-thickness: 1px; }
  .site-footer .footer-back-top:focus-visible { outline: 2px solid #c6e1f1; outline-offset: 5px; border-radius: 2px; }
  .site-footer p,
  .site-footer .footer-links {
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 400;
    line-height: 1.55;
  }
  .site-footer p { margin: 0; color: inherit; }
  .site-footer .footer-copyright { font-size: 15px; }
  .site-footer .footer-updated { margin-top: 8px; color: #bdcbd8; font-size: 13.5px; }
  .site-footer .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 28px;
    font-size: 17px;
  }
  .site-footer .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -10px;
    color: #edf1f5;
    font: inherit;
    font-weight: 500;
    text-decoration: none;
    text-underline-offset: 5px;
  }
  .site-footer .footer-links a:hover {
    color: #c6e1f1;
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .site-footer .footer-links a:focus-visible { outline: 2px solid #c6e1f1; outline-offset: 5px; border-radius: 2px; }
  .site-footer .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 680px) {
    .site-footer { margin-top: 32px; }
    .footer-inner { width: calc(100% - 32px); flex-direction: column; gap: 22px; padding: 28px 0; }
    .site-footer .footer-links { gap: 12px 24px; }
    .footer-navigation { align-items: flex-start; }
  }
</style>
