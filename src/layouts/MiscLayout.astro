---
import { getImage } from "astro:assets";
import miscWatermark from "../assets/misc-watermark.jpg";
import cinema from "../assets/misc-got-pop-up.png";
import PageWatermark from "../components/PageWatermark.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteVersion from "../components/SiteVersion.astro";
import ThemeInit from "../components/ThemeInit.astro";

interface Props {
  title: string;
  overview?: boolean;
  showNavigation?: boolean;
  watermark?: "none" | "cinema";
}

const { title, overview = false, showNavigation = overview, watermark } = Astro.props;
const hasWatermark = watermark !== "none";
const sourceImage = watermark === "cinema" ? cinema : miscWatermark;
const watermarkLabel = watermark === "cinema" ? "My Game of Thrones pop-up book" : "UT Austin garden";
const wallpaper = hasWatermark ? await getImage({
  src: sourceImage,
  width: Math.min(1600, sourceImage.width),
  format: "webp",
  quality: 85,
}) : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${title} — Suraj Dash.`} />
    <SiteVersion />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,650;0,700;1,400&amp;family=STIX+Two+Text:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap" />
    {wallpaper && <link rel="preload" as="image" href={wallpaper.src} />}
    <ThemeInit />
    <title>{title} | Suraj Dash</title>
  </head>
  <body class:list={["misc-page", { "misc-plain-page": !hasWatermark, "misc-pop-up-page": watermark === "cinema" }]}>
    {wallpaper && <PageWatermark src={wallpaper.src} />}
    <main class:list={["page-shell", { "has-site-navigation": showNavigation }]}>
      {showNavigation && <SiteNav current="/misc" />}
      <div class="misc-content">
        {overview ? <>
          <header class="page-heading"><h1>{title}</h1></header>
          <slot />
        </> : <>
          <article class="collection-panel" aria-labelledby="collection-title">
            <h1 id="collection-title">{title}</h1>
            <slot />
          </article>
        </>}
      </div>
      {wallpaper && <p class="background-caption">Watermark: {watermarkLabel}</p>}
      <SiteFooter />
    </main>
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: light;
    --bg: #d9e5df;
    --text: #293c47;
    --heading: #284959;
    --link: #28657e;
    --muted: #596e78;
    --line: rgba(41, 73, 88, .46);
    --card-edge: #547684;
    --caption: #2d4652;
    --caption-shadow: rgba(252, 250, 246, .96);
    --card-bg: rgba(248, 251, 252, .95);
    --card-radius: 14px;
    --card-shadow: 6px 6px 0 rgba(31, 57, 69, .15);
    --focus-ring: #98403a;
    --background-overlay-start: rgba(224, 235, 228, .46);
    --background-overlay-end: rgba(224, 235, 228, .58);
  }
  :global(html[data-theme="light"]) {
    --surface: #f7fafb;
    --shadow: rgba(31, 57, 69, .15);
  }
  :global(html[data-theme="dark"]) {
    color-scheme: dark;
    --bg: #111d1b;
    --text: #d7e0e4;
    --heading: #edf2f4;
    --link: #8abfd2;
    --muted: #acbdc4;
    --line: rgba(195, 215, 224, .20);
    --card-edge: rgba(143, 196, 220, .36);
    --caption: #b7c5ca;
    --caption-shadow: rgba(0, 0, 0, .8);
    --card-bg: rgba(31, 46, 54, .92);
    --card-radius: 20px;
    --card-shadow: 0 14px 36px rgba(0, 0, 0, .24);
    --focus-ring: #8fc4dc;
    --background-overlay-start: rgba(10, 20, 18, .68);
    --background-overlay-end: rgba(10, 20, 18, .78);
  }
  :global(*) { box-sizing: border-box; }
  :global(body) {
    position: relative;
    isolation: isolate;
    margin: 0;
    min-height: 100vh;
    font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 19.8px;
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
  }
  :global(a) { color: var(--link); }
  :global(body.misc-page .page-watermark) {
    background-position: center;
    background-size: auto, cover, auto;
    background-repeat: no-repeat;
  }
  :global(body.misc-pop-up-page .page-watermark) { background-size: auto, contain, auto; }
  :global(body.misc-plain-page) {
    --bg: #d5d0c7;
    --card-bg: #fffdf8;
  }
  :global(html[data-theme="dark"] body.misc-plain-page) {
    --bg: #1b1a19;
    --card-bg: #34322f;
  }
  :global(body.misc-plain-page) .misc-content { width: 100%; margin-bottom: auto; }
  .page-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(1100px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding-top: 64px;
  }
  .page-shell.has-site-navigation { padding-top: 32px; }
  .misc-content { width: min(100%, 980px); flex: none; margin: 0 auto; }
  .page-heading { margin-bottom: 28px; }
  .page-heading h1 { text-shadow: 0 1px 12px rgba(248, 251, 252, .55); }
  :global(html[data-theme="dark"]) .page-heading h1 { text-shadow: 0 1px 12px rgba(0, 0, 0, .35); }
  h1 {
    margin: 0;
    color: var(--heading);
    font-family: "STIX Two Text", Georgia, serif;
    font-size: clamp(32px, 3.4vw, 42px);
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: break-word;
  }
  .collection-panel {
    position: relative;
    min-height: 360px;
    padding: 32px clamp(24px, 4vw, 48px) 38px;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }
  .collection-panel::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: var(--card-edge);
    pointer-events: none;
  }
  :global(html[data-theme="dark"]) .collection-panel::before { box-shadow: 1px 0 8px var(--card-edge); }
  .background-caption {
    margin: auto 0 0;
    padding-top: 32px;
    font-size: .77rem;
    font-weight: 500;
    font-style: italic;
    color: var(--caption);
    text-align: right;
    text-shadow: 0 1px 2px var(--caption-shadow);
  }
  :global(html[data-theme="dark"]) .background-caption { font-weight: 400; opacity: .45; }
  @media (min-width: 1100px) {
    :global(body.misc-plain-page) .page-shell { width: min(1320px, calc(100% - 64px)); }
    .collection-panel { min-height: 365px; }
  }
  @media (max-width: 680px) {
    .page-shell { width: calc(100% - 32px); padding-top: 32px; }
    .page-heading { margin-bottom: 24px; }
    .collection-panel { min-height: 341px; padding: 24px 20px 28px; }
  }
</style>
